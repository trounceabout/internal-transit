---
// index.astro — the start page: the first thing a new visitor sees.
// A full-screen greeting with a single "Start" action (Enter) that leads into
// the site. No top or bottom nav here, by design.
import BaseLayout from "@/layouts/BaseLayout.astro";
import ActionButton from "@/components/ActionButton.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { HOME_HREF } from "@/data/links";
---

<BaseLayout title="Hi there" hideTopNav>
  <main
    class="mx-auto flex min-h-screen w-full max-w-[1200px] flex-col items-center justify-center gap-6 px-6 py-16 text-center"
  >
    <div class="flex flex-col items-center gap-4">
      <p
        data-animate
        class="text-portfolio-muted font-mono text-xl tracking-[1px] sm:text-2xl"
      >
        Hi there
      </p>
      <h1
        data-animate
        class="font-redaction text-portfolio-ink flex items-center gap-4 text-5xl tracking-[-1.92px] sm:text-[64px]"
      >
        <span class="leading-[0.94]">
          I'm <em class="text-portfolio-accent">Cody</em>
        </span>
        <!-- The portrait SVG is a single-color shape (fill="currentColor"), which
             an <img> would always paint black. Using it as a CSS mask over an
             ink-colored box lets it follow the theme instead. -->
        <span
          role="img"
          aria-label="Pixel-art portrait of Cody"
          class="portrait bg-portfolio-ink size-12 sm:size-16"></span>
      </h1>
    </div>

    <!-- The slashes are decorative separators, so they're hidden from
         assistive tech and from small screens, where the items stack. -->
    <p
      data-animate
      class="text-portfolio-muted flex flex-col items-center justify-center gap-x-6 gap-y-1 font-mono text-sm tracking-[1.5px] uppercase sm:flex-row"
    >
      <span>Design Engineer</span>
      <span aria-hidden="true" class="hidden sm:inline">/</span>
      <span>Rock Hill, SC</span>
      <span aria-hidden="true" class="hidden sm:inline">/</span>
      <span>Version 2.0</span>
    </p>

    <div data-animate>
      <SocialLinks class="gap-2" />
    </div>

    <div data-animate class="mt-10">
      <ActionButton
        label="Start"
        shortcut="enter"
        href={HOME_HREF}
        shape="pill"
      />
    </div>
  </main>
</BaseLayout>

<style>
  .portrait {
    -webkit-mask: url("/cody-pixel-portrait-transparent.svg") center / contain
      no-repeat;
    mask: url("/cody-pixel-portrait-transparent.svg") center / contain no-repeat;
  }
</style>
