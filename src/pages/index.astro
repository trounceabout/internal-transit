---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { HugeiconsIcon } from "@hugeicons/react";
import { Calendar04Icon } from "@hugeicons/core-free-icons";
import { categoryConfig } from "@/lib/categoryConfig";
import { projectIconMap } from "@/lib/projectIconMap";

const projects = (
  await getCollection("projects", ({ data }) => data.published)
).sort((a, b) => a.data.order - b.data.order);

// Latest post(s) only — the full list lives at /blog.
const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title="Home">
  <main
    class="mx-auto flex max-w-300 flex-col items-center gap-16 px-6 pt-8 pb-24"
  >
    <div class="flex w-full flex-col items-center gap-8 pt-12 pb-8">
      <p data-animate class="portfolio-headline text-left">
        Hi, I'm
        <span class="whitespace-nowrap">
          <span class="text-portfolio-accent italic">Cody</span>
          <img
            src="/me-big-head-only.svg"
            alt="Cody Keisler"
            class="relative -top-[0.08em] mx-1 inline-block h-[0.85em] w-[0.85em] rounded-full object-cover align-middle"
          />
        </span>
        and I use design to make
        <span class="text-portfolio-accent italic"
          >experiences better for people</span
        >
      </p>
      <p
        data-animate
        class="font-plex-sans text-md text-portfolio-text w-full leading-normal font-light tracking-wider whitespace-nowrap lg:text-lg"
      >
        Product designer based in Rock Hill, SC
      </p>
    </div>

    <div class="flex w-full flex-col items-start gap-6">
      <p
        data-animate
        class="font-plex-sans text-portfolio-muted text-sm font-medium tracking-widest uppercase"
      >
        Work
      </p>
      <div class="flex w-full flex-col items-center">
        {
          projects.map((project) => {
            const ProjectIcon = projectIconMap[project.data.icon];
            return (
              <a href={`/projects/${project.id}`} class="contents">
                <div
                  data-animate
                  class="project-row border-b-portfolio-muted/20 relative -mx-3 flex w-full flex-wrap items-center justify-between gap-4 overflow-hidden border-b p-4"
                  style={{
                    ...(project.data.badgeColor
                      ? { "--badge-color-light": project.data.badgeColor }
                      : {}),
                    ...(project.data.badgeColorDark
                      ? { "--badge-color-dark": project.data.badgeColorDark }
                      : {}),
                    ...(project.data.iconColor
                      ? { "--icon-color-light": project.data.iconColor }
                      : {}),
                    ...(project.data.iconColorDark
                      ? { "--icon-color-dark": project.data.iconColorDark }
                      : {}),
                  }}
                >
                  <div class="relative z-10 flex items-center gap-3">
                    <span
                      class="flex size-8 shrink-0 items-center justify-center rounded-md"
                      style={{ backgroundColor: "var(--badge-color)" }}
                    >
                      <ProjectIcon
                        width={18}
                        height={18}
                        style={{ color: "var(--icon-color)" }}
                      />
                    </span>
                    <p class="text-portfolio-text font-mono text-base tracking-[-0.16px] whitespace-nowrap">
                      {project.data.name}
                    </p>
                  </div>
                  <p class="text-portfolio-muted relative z-10 font-mono text-base tracking-[-0.16px]">
                    {project.data.tagline}
                  </p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>

    <div class="flex w-full flex-col items-start gap-6">
      <p
        data-animate
        class="font-plex-sans text-portfolio-muted text-sm font-medium tracking-[1.12px] uppercase"
      >
        Writing
      </p>
      <div class="flex w-full flex-col gap-8">
        {
          latestPosts.map((post) => (
            <div data-animate class="flex flex-col gap-3">
              <a
                href={`/blog/${post.id}`}
                class="text-portfolio-text hover:text-portfolio-accent font-mono text-base tracking-[-0.16px] transition-colors"
              >
                {post.data.title}
              </a>
              <p class="text-portfolio-muted font-mono text-base tracking-[-0.16px]">
                {post.data.description}
              </p>
              <div class="flex flex-wrap items-center gap-6">
                <div class="flex items-center gap-2">
                  <HugeiconsIcon
                    icon={Calendar04Icon}
                    size={16}
                    className="text-portfolio-muted"
                  />
                  <time
                    datetime={post.data.publishDate.toISOString()}
                    class="text-portfolio-muted font-mono text-sm tracking-[-0.14px]"
                  >
                    {post.data.publishDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                </div>
                {post.data.tags.map((tag) => {
                  const config = categoryConfig[tag];
                  if (!config) return null;
                  const CategoryIcon = config.icon;
                  return (
                    <div class="flex items-center gap-2">
                      <span class={config.text}>
                        <CategoryIcon width={16} height={16} />
                      </span>
                      <span class="text-portfolio-muted font-mono text-sm tracking-[-0.14px]">
                        {tag}
                      </span>
                    </div>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .project-row::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--badge-color, transparent);
    transform: scaleY(0);
    transform-origin: bottom;
    z-index: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-row::before {
      transition: transform 0.2s ease-out;
    }
    .project-row {
      transition: border-color 0.2s ease-out;
    }
  }

  .project-row:hover::before {
    transform: scaleY(1);
  }

  .project-row:hover {
    border-color: var(--icon-color, var(--portfolio-muted));
  }
</style>
