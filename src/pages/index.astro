---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { HugeiconsIcon } from "@hugeicons/react";
import { Calendar04Icon } from "@hugeicons/core-free-icons";
import { categoryConfig } from "@/lib/categoryConfig";
import { projectIconMap } from "@/lib/projectIconMap";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);

// Latest post(s) only — the full list lives at /blog.
const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
    .slice(0, 2);
---

<BaseLayout title="Home">
    <main class="flex flex-col items-center mx-auto px-6 pt-8 pb-24 max-w-300 gap-16">
        <div class="flex flex-col items-center gap-8 w-full pt-12 pb-8">
            <p
                data-animate
                class="font-redaction text-[56px] sm:text-[80px] lg:text-[80px] leading-[0.94] tracking-[-1.68px] sm:tracking-[-2.4px] lg:tracking-[-3.36px] text-portfolio-ink text-left"
            >
                Hi, I'm
                <span class="whitespace-nowrap">
                    <span class="text-portfolio-accent italic">Cody</span>
                    <img
                        src="/me-big-head-only.svg"
                        alt="Cody Keisler"
                        class="inline-block align-middle relative -top-[0.08em] w-[0.85em] h-[0.85em] rounded-full object-cover mx-1"
                    />
                </span>
                 and I use design to make
                <span class="text-portfolio-accent italic">experiences better
                for people</span>
            </p>
            <p data-animate class="font-plex-sans font-light text-md tracking-wider lg:text-lg leading-normal text-portfolio-ink whitespace-nowrap w-full">
                Product designer based in Rock Hill, SC
            </p>
        </div>

        <div class="flex flex-col gap-6 items-start w-full">
            <p data-animate class="font-plex-sans font-medium text-sm tracking-widest uppercase text-portfolio-muted">
                Work
            </p>
            <div class="flex flex-col items-center w-full">
                {
                    projects.map((project) => {
                        const row = (
                            <div
                                data-animate
                                class="project-row relative overflow-hidden flex items-center justify-between gap-4 w-full flex-wrap p-4 -mx-3 border-b border-b-portfolio-muted-2/20"
                                style={{
                                    ...(project.data.badgeColor ? { "--badge-color": project.data.badgeColor } : {}),
                                    ...(project.data.iconColor ? { "--icon-color": project.data.iconColor } : {}),
                                }}
                            >
                                <div class="relative z-10 flex items-center gap-3">
                                    <span
                                            class="flex items-center justify-center size-8 rounded-md shrink-0"
                                            style={{ backgroundColor: project.data.badgeColor }}
                                        >
                                            <HugeiconsIcon
                                                icon={projectIconMap[project.data.icon]}
                                                size={18}
                                                color={project.data.iconColor}
                                            />
                                        </span>
                                    <p class="font-mono text-base tracking-[-0.16px] text-portfolio-ink whitespace-nowrap">
                                        {project.data.name}
                                    </p>
                                </div>
                                <p class="relative z-10 font-mono text-base tracking-[-0.16px] text-portfolio-muted-2">
                                    {project.data.tagline}
                                </p>
                            </div>
                        );
                        return project.data.published ? (
                            <a href={`/projects/${project.id}`} class="w-full">
                                {row}
                            </a>
                        ) : (
                            row
                        );
                    })
                }
            </div>
        </div>

        <div class="flex flex-col gap-6 items-start w-full">
            <p data-animate class="font-plex-sans font-medium text-sm tracking-[1.12px] uppercase text-portfolio-muted">
                Writing
            </p>
            <div class="flex flex-col gap-8 w-full">
                {
                    latestPosts.map((post) => (
                        <div data-animate class="flex flex-col gap-3">
                            <a
                                href={`/blog/${post.id}`}
                                class="font-mono text-base tracking-[-0.16px] text-portfolio-ink hover:text-portfolio-accent transition-colors"
                            >
                                {post.data.title}
                            </a>
                            <p class="font-mono text-base tracking-[-0.16px] text-portfolio-muted-2">
                                {post.data.description}
                            </p>
                            <div class="flex items-center gap-6 flex-wrap">
                                <div class="flex items-center gap-2">
                                    <HugeiconsIcon
                                        icon={Calendar04Icon}
                                        size={16}
                                        className="text-portfolio-muted-2"
                                    />
                                    <time
                                        datetime={post.data.publishDate.toISOString()}
                                        class="font-mono text-sm tracking-[-0.14px] text-portfolio-muted-2"
                                    >
                                        {post.data.publishDate.toLocaleDateString(
                                            "en-US",
                                            { year: "numeric", month: "short", day: "numeric" },
                                        )}
                                    </time>
                                </div>
                                {post.data.tags.map((tag) => {
                                    const config = categoryConfig[tag];
                                    if (!config) return null;
                                    return (
                                        <div class="flex items-center gap-2">
                                            <span class={config.text}>
                                                <HugeiconsIcon
                                                    icon={config.icon}
                                                    size={16}
                                                    color="currentColor"
                                                />
                                            </span>
                                            <span class="font-mono text-sm tracking-[-0.14px] text-portfolio-muted-2">
                                                {tag}
                                            </span>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    .project-row::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--badge-color, transparent);
        transform: scaleY(0);
        transform-origin: bottom;
        z-index: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
        .project-row::before {
            transition: transform 0.2s ease-out;
        }
        .project-row {
            transition: border-color 0.2s ease-out;
        }
    }

    .project-row:hover::before {
        transform: scaleY(1);
    }

    .project-row:hover {
        border-color: var(--icon-color, var(--portfolio-muted-2));
    }
</style>
