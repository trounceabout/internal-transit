---
// ProjectLayout.astro — wraps an individual project's case-study page.
//
// A case study is one page made of four full-screen sections the reader
// scrolls through, with CSS scroll-snap aligning each to the top of the
// screen:
//   Overview     — an oversized title-slide presentation (Overview.astro)
//   Deep dive    — the write-up: the MDX body passed in through <slot />
//   Walkthrough  — the Loom recording (Walkthrough.astro)
//   Gallery      — every still and loop in one grid (Gallery.astro)
// A side nav (SubNav.astro) tracks the current section, and the bottom nav
// swaps its actions per section. The scroll-tracking lives in
// src/lib/caseStudy.ts.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Lightbox from "@/components/Lightbox.astro";
import SubNav from "@/components/case-study/SubNav.astro";
import Overview from "@/components/case-study/Overview.astro";
import Walkthrough from "@/components/case-study/Walkthrough.astro";
import Gallery from "@/components/case-study/Gallery.astro";
import MobileSectionBar from "@/components/MobileSectionBar.astro";
import type { NavAction } from "@/layouts/BottomNav.astro";
import type { ComponentType, SVGProps } from "react";

interface GalleryItem {
  kind: "image" | "video";
  src?: string;
  webm?: string;
  mp4?: string;
  alt: string;
  label: string;
  caption: string;
}

interface Props {
  slug: string;
  name: string;
  tagline: string;
  icon: ComponentType<SVGProps<SVGSVGElement>>;
  iconColor?: string;
  iconColorDark?: string;
  badgeColor?: string;
  badgeColorDark?: string;
  description?: string;
  accentPhrase?: string;
  loomUrl?: string;
  role?: string;
  scope?: string;
  type?: string;
  heroArt?: "toasts" | "mark" | "cpu-card";
  gallery?: GalleryItem[];
  // The project the "Next project" action leads to (wraps around to the first).
  next?: { slug: string; name: string };
}

const {
  slug,
  name,
  tagline,
  icon,
  iconColor,
  iconColorDark,
  badgeColor,
  badgeColorDark,
  description,
  accentPhrase,
  loomUrl,
  role,
  scope,
  type,
  heroArt,
  gallery = [],
  next,
} = Astro.props;

const hasWalkthrough = Boolean(loomUrl);
const hasGallery = gallery.length > 0;

// Per-project colors as inline custom properties on the page root; global.css
// resolves them to --icon-color / --badge-color for the active theme, and every
// section below inherits them.
const colorVars = {
  ...(iconColor ? { "--icon-color-light": iconColor } : {}),
  ...(iconColorDark ? { "--icon-color-dark": iconColorDark } : {}),
  ...(badgeColor ? { "--badge-color-light": badgeColor } : {}),
  ...(badgeColorDark ? { "--badge-color-dark": badgeColorDark } : {}),
};

// Chips for the small-screen section bar (top-level sections only; the side
// nav's Deep dive sub-items are desktop-only).
const sectionChips = [
  { id: "overview", label: "Overview" },
  { id: "deep-dive", label: "Deep dive" },
  ...(hasWalkthrough ? [{ id: "walkthrough", label: "Walkthrough" }] : []),
  ...(hasGallery ? [{ id: "gallery", label: "Gallery" }] : []),
];

// Loom share URLs (loom.com/share/<id>) don't render embedded — the player
// requires the /embed/<id> path. Only needed here for the preconnect hints.
const embedSrc = loomUrl?.replace("/share/", "/embed/");

// Bottom-nav actions: Next project (X) and Back (Esc, to the project's home
// preview), the same in every section. The Overview's own "Read deep dive /
// Watch walkthrough / View gallery" actions are buttons inside that section.
const actions: NavAction[] = [
  ...(next
    ? [
        {
          label: "Next project",
          detail: next.name.replace(/^Project\s+/, ""),
          shortcut: "x",
          href: `/projects/${next.slug}`,
        },
      ]
    : []),
  { label: "Back", shortcut: "esc", href: `/home/${slug}` },
];
---

<BaseLayout
  page="case-study"
  section="overview"
  title={name}
  description={tagline}
  actions={actions}
>
  {
    /* Warms up the connection to Loom's domains as soon as the page loads,
      instead of paying full DNS+TLS+redirect latency when the reader scrolls
      to the walkthrough. Rendered into BaseLayout's named "head" slot — a
      link in the default slot stays in the body where it's written, it isn't
      auto-hoisted to the head the way style and script tags are. */
  }
  {
    embedSrc && (
      <Fragment slot="head">
        <link rel="preconnect" href="https://www.loom.com" />
        <link rel="preconnect" href="https://cdn.loom.com" crossorigin />
      </Fragment>
    )
  }

  <div
    data-case-study
    style={colorVars}
    class="mx-auto -mt-20 w-full max-w-[1248px] px-6 lg:grid lg:grid-cols-[260px_minmax(0,900px)] lg:gap-10"
  >
    <!-- The -mt-20 pulls this up by the sticky header's height (h-20), so the
         Overview starts at the very top of the page and its snap point is
         scroll position 0, with the header floating over it. -->
    <!-- Side nav: sticky so it stays put while the sections scroll past.
         Hidden on narrow screens for now (small-screen pass comes later). -->
    <!-- It fades away on the Overview, which is a full-width presentation. -->
    <aside data-subnav-aside class="hidden lg:block">
      <div class="sticky top-40">
        <SubNav hasWalkthrough={hasWalkthrough} hasGallery={hasGallery} />
      </div>
    </aside>

    <div class="min-w-0">
      <MobileSectionBar items={sectionChips} navAttr="data-subnav-mobile" />
      <section
        id="overview"
        data-section="overview"
        class="case-section case-section--overview"
      >
        <Overview
          name={name}
          tagline={tagline}
          accentPhrase={accentPhrase}
          description={description ?? tagline}
          icon={icon}
          heroArt={heroArt}
          type={type}
          role={role}
          scope={scope}
          hasWalkthrough={hasWalkthrough}
          hasGallery={hasGallery}
        />
      </section>

      <section id="deep-dive" data-section="deep-dive" class="case-section">
        {
          /* The write-up. `.article-body` carries the MDX typography and the
          .ping-section* card styles below. */
        }
        <div
          class="article-body font-plex-sans text-portfolio-ink text-base leading-8"
        >
          <slot />
        </div>
      </section>

      {
        loomUrl && (
          <section
            id="walkthrough"
            data-section="walkthrough"
            class="case-section"
          >
            <Walkthrough loomUrl={loomUrl} name={name} />
          </section>
        )
      }

      {
        hasGallery && (
          <section id="gallery" data-section="gallery" class="case-section">
            <Gallery items={gallery} />
          </section>
        )
      }
    </div>
  </div>

  <Lightbox />
</BaseLayout>

<script>
  import { observeGridReveal } from "@/lib/animations";
  import { initCaseStudy } from "@/lib/caseStudy";

  // Runs on first load and after every client-side navigation, so each case
  // study you open re-binds scroll tracking, replays the Overview entrance, and
  // animates the "Approach" dot grid.
  document.addEventListener("astro:page-load", () => {
    initCaseStudy();
    observeGridReveal();
  });
</script>

<style>
  /* MDX content comes from a separately-compiled component tree (rendered via
     <Content /> in [slug].astro), so Astro's default *scoped* styles never
     attach to it — every rule here needs :global() or it silently does nothing. */
  /* Two separate spacing tokens, easy to conflate but serving different
     jobs:
       --ping-section-gap   — vertical rhythm BETWEEN sections. Stays a
                               fixed 60px at every viewport width — this is
                               breathing room in the reading flow, not
                               something that should compress on mobile.
       --ping-card-padding   — the INSET inside a bordered/gradient card
                               (Problem/Approach/Solution) and the
                               <article> wrapper's own horizontal margin.
                               This one DOES scale down on narrow screens
                               (24px mobile / 40px tablet / 60px desktop,
                               matching <article>'s own
                               px-6 sm:px-10 lg:px-[60px]) — a flat 60px
                               inset squished the readable column badly on
                               phones. Collapsing both into one variable
                               previously made the inter-section gap shrink
                               along with the card padding, which read as
                               sections crowding each other on mobile. */
  .article-body {
    --ping-section-gap: 3.75rem; /* 60px, fixed at every width */
    --ping-card-padding: 1.5rem; /* 24px */
  }

  @media (min-width: 40rem) {
    .article-body {
      --ping-card-padding: 2.5rem; /* 40px */
    }
  }

  @media (min-width: 64rem) {
    .article-body {
      --ping-card-padding: 3.75rem; /* 60px */
    }
  }

  /* Each top-level block in the MDX body is wrapped in its own
     `.ping-section`, so this gap can sit on both sides of a section as
     real padding (padding needs a real box on each edge — a
     margin-collapse-via-adjacency-selector approach only works for a flat
     list of siblings, and margin between siblings COLLAPSES rather than
     stacking, which reads as inconsistent spacing once some sections also
     have their own border/background — a card's edge should have a
     definite, non-collapsing gap around it). The first section only gets
     bottom padding, matching Figma's Intro frame using pb-[60px] instead
     of py-[60px] since there's nothing above it to pad against.
     Problem/Approach/Solution below add their own padding-LEFT/RIGHT only
     (not the `padding` shorthand) — the shorthand would overwrite this
     rule's padding-top/-bottom outright, since both rules have equal
     specificity and the later one wins on every side it touches. Setting
     only the two horizontal longhands here means their own left/right
     inset composes with (rather than replaces) this rule's vertical gap. */
  .article-body :global(.ping-section) {
    padding-top: var(--ping-section-gap);
    padding-bottom: var(--ping-section-gap);
  }

  /* Only the intro drops its top padding (nothing above it to pad against). A
     bare :first-child would also strip the Problem card's top padding, since
     that card is the first child of its .ps-card wrapper. */
  .article-body :global(#intro) {
    padding-top: 0;
  }

  /* "The problem" gets a plain 1px stroke outline and its own left/right
     inset (on top of the padding-top/-bottom every section already has
     from the rule above) — the one section styled as a bordered card
     rather than a plain full-bleed block. padding-top/-bottom here
     re-declare --ping-section-gap (the FIXED token), not
     --ping-card-padding (the responsive one) — using the responsive
     variable for the vertical sides was the exact bug this replaced:
     it made this section's vertical gap shrink along with its horizontal
     inset on mobile, instead of staying fixed like every other section's. */
  .article-body :global(.ping-section--problem) {
    border: 1px solid var(--section-border-color);
    border-radius: 0.75rem; /* 12px */
    padding-top: var(--ping-section-gap);
    padding-bottom: var(--ping-section-gap);
    padding-left: var(--ping-card-padding);
    padding-right: var(--ping-card-padding);
    margin-top: var(--ping-card-padding);
    margin-bottom: var(--ping-card-padding);
  }

  /* "The approach" gets the same left/right inset, matching "The problem"
     above — vertical padding stays on the fixed --ping-section-gap for
     the same reason. position: relative gives the ::after grid layer
     below a containing block to size itself against. Unlike "The problem",
     this section stays borderless/full-bleed on purpose — the border is
     what marks Problem as the one "card" section, and adding one here
     would blur that distinction. No overflow: hidden here (unlike the
     original version of this rule) — the ::after grid layer below is
     deliberately wider than this section's own box (it bleeds 40px past
     the left/right edges), and clipping at the section boundary would
     hide exactly that bleed. The page-level overflow-x-hidden on <body>
     (BaseLayout.astro) is what stops that bleed from ever causing a
     horizontal scrollbar on narrow viewports. */
  .article-body :global(.ping-section--approach) {
    position: relative;
    padding-top: var(--ping-section-gap);
    padding-bottom: var(--ping-section-gap);
    padding-left: var(--ping-card-padding);
    padding-right: var(--ping-card-padding);
  }

  /* Decorative dot-grid background for "The approach". A single tiled
     radial-gradient draws a 1px dot every 24px using the same weak
     --section-border-color hairline already used for "The problem"'s
     outline, so it reads as part of this design system rather than a
     borrowed effect. (An earlier version of this used a two-axis
     repeating-linear-gradient line grid, matching aphera.co's reference;
     swapped to dots after finding a closer reference. A per-project
     accent-color tint was also tried and reverted — read as too loud/
     colorful for this background texture even at 25% strength; the
     neutral hairline color works better.)
     Deliberately ::after, not ::before: generated content always paints
     after an element's real children by spec, so ::after guarantees this
     stays behind the section's images/copy without depending on z-index
     stacking order against the LightboxImage markup (which has its own
     position: relative wrapper). The negative z-index below is
     belt-and-suspenders on top of that. Also inert to pointer/click
     interaction. Starts fully transparent — observeGridReveal()
     (src/lib/animations.ts) adds .grid-active via IntersectionObserver
     once the section scrolls into view, which is what actually plays the
     gridSequence fade (defined in global.css). */
  .article-body :global(.ping-section--approach::after) {
    content: "";
    position: absolute;
    /* Bleeds the grid 40px past the section's own left/right edges (top/bottom
       stay flush) so it reads as wider than the text column above it, similar
       to aphera.co's reference. This section has no overflow: hidden of its
       own (unlike "The problem"/"The solution") specifically so this bleed
       isn't clipped — the page-level overflow-x-hidden on <body>
       (BaseLayout.astro) is what stops it from ever causing a horizontal
       scrollbar on narrow viewports instead. */
    inset: 0 -40px;
    /* "1px, transparent 1px" (not "0, transparent 1px") is what makes a
       crisp dot instead of a soft blurred blob — the color stays solid from
       center out to the 1px radius, then cuts hard to transparent at that
       same radius. */
    background-image: radial-gradient(
      circle,
      var(--section-border-color) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    /* Fades the grid out near all four edges instead of cutting off hard
       — two gradients (one per axis) multiplied together via
       mask-composite: intersect, so a point only stays fully opaque where
       BOTH the horizontal and vertical fade are opaque (i.e. away from
       every edge at once). -webkit- variants are Safari's still-required
       prefixed equivalents (mask-composite ergo is broadly supported
       unprefixed now, but -webkit-mask-composite uses different keyword
       values, hence "source-in" there vs "intersect" above). */
    mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 1) 10%,
        rgba(0, 0, 0, 1) 90%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 1) 10%,
        rgba(0, 0, 0, 1) 90%,
        transparent 100%
      );
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 1) 10%,
        rgba(0, 0, 0, 1) 90%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 1) 10%,
        rgba(0, 0, 0, 1) 90%,
        transparent 100%
      );
    -webkit-mask-composite: source-in;
    pointer-events: none;
    z-index: -1;
    opacity: 0;
  }

  .article-body :global(.ping-section--approach.grid-active::after) {
    animation: gridSequence 1.4s ease-out forwards;
  }

  /* "The solution" gets a translucent border and a subtle vertical-fade
     background, both tinted by the project's own --icon-color (set inline
     in the MDX, resolved the same way the headline accent and Postscript's
     divider already do) — so each case study gets a matching treatment in
     its own accent color instead of every project showing Ping's red.
     color-mix() against transparent is what lets a var()-sourced color
     carry a percentage opacity — CSS's plain `color / alpha%` syntax only
     accepts a literal color, not a custom property. */
  .article-body :global(.ping-section--solution) {
    border-radius: 0.75rem; /* 12px */
    padding-top: var(--ping-section-gap);
    padding-bottom: var(--ping-section-gap);
    padding-left: var(--ping-card-padding);
    padding-right: var(--ping-card-padding);
    margin-top: var(--ping-card-padding);
    margin-bottom: var(--ping-card-padding);
    border: 1px solid color-mix(in oklch, var(--icon-color) 50%, transparent);
    background: linear-gradient(
      0deg,
      color-mix(in oklch, var(--icon-color) 0%, transparent) 0%,
      color-mix(in oklch, var(--icon-color) 13%, transparent) 100%
    );
    background-origin: border-box;
    background-clip: padding-box, padding-box, border-box;
  }

  /* A heading still sits close to the content directly under it (16px),
     same as Figma's "The problem"/"The approach" heading+paragraph groups —
     this is intra-section spacing, unaffected by the section padding above. */
  .article-body :global(h2 + *) {
    margin-top: 1rem; /* 16px */
  }

  .article-body :global(h2) {
    font-family: var(--font-plex-sans);
    font-weight: 600; /* Figma "Article/Heading": SemiBold */
    font-size: 1.5rem; /* 24px */
    line-height: 2.5rem; /* 40px */
    color: var(--portfolio-ink);
  }

  .article-body :global(p) {
    font-family: var(--font-plex-sans);
    font-size: 1.125rem; /* 18px */
    line-height: 2rem; /* 32px */
    font-weight: 300;
  }

  /* Paragraphs immediately following another paragraph (e.g. "The problem"'s
     three-paragraph run) sit tighter than the 40px inter-block gap above —
     Figma treats runs of body copy as one 16px-spaced group. */
  .article-body :global(p + p) {
    margin-top: 1rem; /* 16px */
  }

  /* Every `.ping-section` in Figma is a `flex flex-col gap-[40px]` —
     Intro's paragraphs vs. its image, Approach's copy vs. its two-image row,
     a Point's LabeledRow vs. its LoopVideo, all 40px apart regardless of
     element type. This is intra-section spacing between a section's direct
     children, distinct from `.ping-section`'s own 60px outer padding above.
     `:not(p)` keeps this from overriding the tighter 16px `p + p` run
     spacing below — a `p` following a `p` should stay at 16px, not jump to
     40px just because both happen to sit inside a `.ping-section`. */
  .article-body :global(.ping-section > * + *:not(p)) {
    margin-top: 2.5rem; /* 40px */
  }

  .article-body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-underline-position: from-font;
  }

  /* ─── Case-study page: snap sections ─────────────────────────────────────── */
  /* Each section fills the screen and snaps to its top edge. `mandatory` makes
     the browser always settle on a section start, but a section taller than
     the screen (the deep dive) still scrolls freely inside; only once you
     reach its end does it ask for roughly half a screen more of scroll before
     it snaps forward to the next section — that's the "hump". Scoped with
     :has() so it only applies on pages that contain a case study. */
  :global(html:has([data-case-study])) {
    scroll-snap-type: y mandatory;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has([data-case-study])) {
      scroll-behavior: smooth;
    }
    /* Hidden until the Overview entrance animation (lib/caseStudy.ts) reveals
       them, so they don't flash visible first. */
    :global([data-ov]) {
      opacity: 0;
    }
  }
  /* The deep dive and gallery are taller than the screen. With only a `start`
     snap point they have nothing to rest on at their bottom: scrolling down
     jumped straight on to the next section before the end (the postscript) was
     readable, and scrolling back up shot to the section's top. `start end` adds
     a second snap point with the section's bottom edge at the bottom of the
     screen, and the browser still scrolls freely between the two. */
  #deep-dive,
  #gallery {
    scroll-snap-align: start end;
  }
  .case-section {
    scroll-snap-align: start;
    min-height: 100dvh;
    /* Top: room for the sticky header, plus the section chip bar on small
       screens (below lg, where the side nav is replaced by that bar). Bottom:
       room for the fixed action bar. */
    padding-top: 8.5rem;
    padding-bottom: 8rem;
  }
  /* From lg, content starts 160px down (Figma: 56px page padding + the 24px
     header row + 80px gap); the side nav is pinned at the same line. */
  @media (min-width: 64rem) {
    .case-section {
      padding-top: 10rem;
    }
  }

  /* The Overview is a full-width title slide, not part of the 900px reading
     column: from lg it stretches back across the side-nav gutter (the 300px
     margin cancels the grid's first column + gap) and centers its content in
     the full 1200px. Its content starts 160px down, as in Figma (56px page
     padding + 104px under the header row). */
  .case-section--overview {
    padding-top: 8rem;
    padding-bottom: 8rem;
  }
  @media (min-width: 64rem) {
    .case-section--overview {
      width: 1200px;
      margin-left: -300px;
      padding-top: 160px;
    }
  }
  /* Short laptop windows: pull the content up so the whole slide still fits. */
  @media (min-width: 64rem) and (max-height: 900px) {
    .case-section--overview {
      padding-top: 112px;
    }
  }

  /* The side nav only belongs to the sections after the Overview: fade it out
     (and make it inert) while the Overview is showing. */
  [data-subnav-aside] {
    transition:
      opacity 0.3s ease-out,
      visibility 0.3s;
  }
  :global(body[data-section="overview"]) [data-subnav-aside] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Jumping to a sub-item (e.g. #approach) shouldn't tuck it under the header. */
  .article-body :global([id]) {
    scroll-margin-top: 6rem;
  }

  /* ─── Deep dive: intro ─────────────────────────────────────────────────── */
  /* The opening paragraph is a larger lead-in (Figma "Article/Description":
     Plex Sans Regular 24/40). The intro's blocks sit 28px apart. */
  .article-body :global(#intro > p:first-child) {
    font-size: 1.5rem; /* 24px */
    line-height: 2.5rem; /* 40px */
    font-weight: 400;
    color: var(--portfolio-ink);
  }
  /* Figma's hero screenshot is a fixed 1440:882 crop. */
  .article-body :global(#intro .lightbox-hover-wrap img) {
    aspect-ratio: 1440 / 882;
    object-fit: cover;
    object-position: top;
  }
  .article-body :global(#intro > * + *) {
    margin-top: 1.75rem; /* 28px */
  }

  /* ─── Deep dive: Problem + Solution ────────────────────────────────────── */
  /* Two stacked cards that overlap by 24px: the Problem card sits on top (an
     opaque, faintly raised surface) and the Solution card tucks in beneath it,
     so its outline peeks out around the Problem card's rounded bottom corners. */
  .article-body :global(.ps-card) {
    display: flow-root;
  }
  /* Figma draws these borders inside the box, so the 1px comes out of the 60px
     padding (a 464px / 272px card, not 466 / 274). */
  .article-body :global(.ps-card .ping-section) {
    padding: calc(var(--ping-section-gap) - 1px)
      calc(var(--ping-card-padding) - 1px);
  }
  .article-body :global(.ps-card .ping-section--problem) {
    position: relative;
    z-index: 2;
    margin: 0 0 -24px;
    background: color-mix(
      in srgb,
      var(--portfolio-ink) 4%,
      var(--portfolio-bg)
    );
  }
  .article-body :global(.ps-card .ping-section--solution) {
    position: relative;
    z-index: 1;
    margin: 0;
    border: 1px solid var(--icon-color);
    /* Brightest at the bottom, fading out toward the top (Figma: to-top,
       13% to 0%). */
    background: linear-gradient(
      0deg,
      color-mix(in oklch, var(--icon-color) 13%, transparent) 0%,
      color-mix(in oklch, var(--icon-color) 0%, transparent) 100%
    );
  }

  /* ─── Deep dive: Before / After ────────────────────────────────────────── */
  .article-body :global(.before-after) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .article-body :global(.before-after) {
      flex-direction: row;
    }
  }

  /* ─── Deep dive: numbered feature blocks ───────────────────────────────── */
  /* Each "From X to Y" block is a title row, its description, then the media
     32px below; the numbers (01, 02, ...) come from a CSS counter. */
  .article-body {
    counter-reset: feature;
  }
  .article-body :global(.ping-section:has(> .labeled-row) > * + *) {
