---
// ProjectLayout.astro — wraps an individual project's case-study page.
// Adapted from BlogLayout.astro: swaps the date+tags meta row for a single
// icon+eyebrow badge, and adds a Role/Scope properties row plus a Loom embed
// (hidden until the reader opts in via "Watch the overview") that articles
// don't have.
import BaseLayout from './BaseLayout.astro';
import Lightbox from '@/components/Lightbox.astro';
import PillButton from '@/components/case-study/PillButton.astro';
import { Home } from 'pixelarticons/react/Home';
import { Play } from 'pixelarticons/react/Play';
import type { ComponentType, SVGProps } from 'react';

interface Props {
  name: string;
  tagline: string;
  icon: ComponentType<SVGProps<SVGSVGElement>>;
  iconColor?: string;
  iconColorDark?: string;
  badgeColor?: string;
  badgeColorDark?: string;
  description?: string;
  accentPhrase?: string;
  loomUrl?: string;
  role?: string;
  scope?: string;
}

const {
  name,
  tagline,
  icon,
  iconColor,
  iconColorDark,
  badgeColor,
  badgeColorDark,
  description,
  accentPhrase,
  loomUrl,
  role,
  scope,
} = Astro.props;

// Dek paragraph (the 24px intro copy under the headline) prefers the longer
// `description`, falling back to the shorter home-page-list `tagline` when a
// case study hasn't set one yet.
const dek = description ?? tagline;

// Same split-around-a-phrase technique as BlogLayout's accentWord, but
// colored by the project's own iconColor rather than a shared category
// config. Applied to `tagline` (the headline text), not `dek` — the
// headline and the intro paragraph below it are two separate strings.
const accentIndex = accentPhrase ? tagline.indexOf(accentPhrase) : -1;
const taglineBefore = accentIndex >= 0 ? tagline.slice(0, accentIndex) : tagline;
const taglineAfter = accentIndex >= 0 ? tagline.slice(accentIndex + (accentPhrase?.length ?? 0)) : '';

// Loom share URLs (loom.com/share/<id>) don't render embedded — the player
// requires the /embed/<id> path.
const embedSrc = loomUrl?.replace('/share/', '/embed/');

// JSX/Astro only renders a variable as a component if it starts with a
// capital letter — `icon` comes in lowercase as a prop, so it needs a
// capitalized alias before it can be used as `<Icon />` below.
const Icon = icon;
---

<BaseLayout title={name} description={tagline}>
  {/* Warms up the connection to Loom's domains as soon as the page loads,
      instead of paying full DNS+TLS+redirect latency at the moment the
      reader clicks "Watch the overview". Rendered into BaseLayout's named
      "head" slot — a <link> in the default slot stays in <body> where
      it's written, it isn't auto-hoisted to <head> the way <style>/<script>
      tags are. */}
  {embedSrc && (
    <Fragment slot="head">
      <link rel="preconnect" href="https://www.loom.com" />
      <link rel="preconnect" href="https://cdn.loom.com" crossorigin />
    </Fragment>
  )}
  <main class="mx-auto max-w-[1120px] py-18">
    <article class="px-[60px]">
      <header data-animate class="flex flex-col gap-8 mb-12">
        {/* Breadcrumb: Home badge, then the project's own icon badge + eyebrow label
            (that project badge/label markup matches the home page's Work list rows) */}
        <div class="flex items-center gap-4">
          <a href="/" class="flex items-center gap-2">
            <span class="flex items-center justify-center size-7 rounded-md bg-portfolio-muted/15">
              <Home width={16} height={16} className="text-portfolio-muted" />
            </span>
            <span class="font-mono text-base text-portfolio-muted underline">Home</span>
          </a>
          <span class="text-portfolio-muted">•</span>
          <div class="flex items-center gap-2">
            <span
              class="flex items-center justify-center size-7 rounded-md shrink-0"
              style={{
                backgroundColor: 'var(--badge-color)',
                ...(badgeColor ? { '--badge-color-light': badgeColor } : {}),
                ...(badgeColorDark ? { '--badge-color-dark': badgeColorDark } : {}),
              }}
            >
              <Icon
                width={16}
                height={16}
                style={{
                  color: 'var(--icon-color)',
                  ...(iconColor ? { '--icon-color-light': iconColor } : {}),
                  ...(iconColorDark ? { '--icon-color-dark': iconColorDark } : {}),
                }}
              />
            </span>
            <p class="font-mono text-base tracking-[-0.18px] text-portfolio-ink">{name}</p>
          </div>
        </div>

        {/* Headline — accentPhrase (if set) renders italicized in the project's own iconColor */}
        <h1 class="font-redaction text-[80px] tracking-[-2.4px] leading-[0.94] text-portfolio-ink">
          {taglineBefore}
          {accentIndex >= 0 && (
            <span
              class="italic"
              style={{
                color: 'var(--icon-color)',
                ...(iconColor ? { '--icon-color-light': iconColor } : {}),
                ...(iconColorDark ? { '--icon-color-dark': iconColorDark } : {}),
              }}
            >{accentPhrase}</span>
          )}
          {taglineAfter}
        </h1>
      </header>

      {/* Body — same max-width and typography as the article template's body column */}
      <div data-animate class="max-w-[800px] flex flex-col gap-10">
        <p class="font-plex-sans text-2xl leading-10 text-portfolio-ink">
          {dek}
        </p>

        {(embedSrc || role || scope) && (
          <div class="flex flex-col gap-10">
            {/* Properties row: overview toggle + Role/Scope, all optional so
                a case study can omit any of them. The toggle now opens the
                shared Lightbox (rendered once below) instead of an inline
                accordion — clicking it is just another lightbox trigger,
                identified to Lightbox.astro's delegated listener the same
                way a case-study image is (see LightboxImage.astro). */}
            <div class="flex flex-wrap gap-10 items-start">
              {embedSrc && (
                <PillButton
                  id="overview-toggle"
                  icon={Play}
                  label="Watch the overview"
                  iconColor="oklch(54.6% 0.245 262.881)"
                  background="color-mix(in oklch, oklch(54.6% 0.245 262.881) 15%, transparent)"
                  data-lightbox-trigger
                  data-lightbox-type="iframe"
                  data-lightbox-src={embedSrc}
                />
              )}

              {role && (
                <div class="flex flex-col gap-1 font-mono text-sm tracking-[-0.14px]">
                  <p class="text-portfolio-muted">Role</p>
                  <p class="text-portfolio-ink whitespace-nowrap">{role}</p>
                </div>
              )}

              {scope && (
                <div class="flex flex-col gap-1 flex-1 min-w-[240px] font-mono text-sm tracking-[-0.14px]">
                  <p class="text-portfolio-muted">Scope</p>
                  <p class="text-portfolio-ink">{scope}</p>
                </div>
              )}
            </div>
          </div>
        )}

        {/* Rest of the MDX body */}
        <div class="article-body font-plex-sans text-base leading-8 text-portfolio-ink">
          <slot />
        </div>
      </div>
    </article>
  </main>

  <Lightbox />
</BaseLayout>

<style>
  /* MDX content comes from a separately-compiled component tree (rendered via
     <Content /> in [slug].astro), so Astro's default *scoped* styles never
     attach to it — every rule here needs :global() or it silently does nothing.
     Mirrors BlogLayout.astro's identical block. */
  /* Each top-level block in the MDX body is wrapped in its own
     `.ping-section`, so 60px of breathing room can sit on both sides of a
     section (padding needs a real box on each edge — unlike the previous
     margin-collapse-via-adjacency-selector approach, which only worked for
     a flat list of siblings). The first section only gets bottom padding,
     matching Figma's Intro frame using pb-[60px] instead of py-[60px]
     since there's nothing above it to pad against. */
  .article-body :global(.ping-section) {
    padding-top: 3.75rem; /* 60px */
    padding-bottom: 3.75rem; /* 60px */
  }

  .article-body :global(.ping-section:first-child) {
    padding-top: 0;
  }

  /* "The problem" gets a plain 1px stroke outline and padding on all four
     sides (not just top/bottom) — the one section styled as a bordered
     card rather than a plain full-bleed block. */
  .article-body :global(.ping-section--problem) {
    border: 1px solid var(--section-border-color);
    border-radius: 0.75rem; /* 12px */
    padding: 3.75rem; /* 60px, all sides */
  }

  /* "The approach" gets padding on all four sides, matching "The problem"
     above. */
  .article-body :global(.ping-section--approach) {
    padding: 3.75rem; /* 60px, all sides */
  }

  /* "The solution" gets a gradient background + a genuine gradient border,
     both tinted by the project's own --icon-color (set inline in the MDX,
     resolved the same way the headline accent and Postscript's divider
     already do) — so a future case study with a different accent color
     gets a matching treatment instead of Ping's specific red. A plain
     `border-color` can't be a gradient, so this uses the standard
     double-background technique: three stacked background-images, the
     first painted into the padding-box as an opaque page-background
     stand-in (so the middle/inner area isn't see-through where the two
     accent gradients don't fully cover it), the second (the fill
     gradient) also clipped to the padding-box, and the third (the border
     gradient) clipped to the border-box beneath a transparent border,
     which reveals it only along the border's own width. */
  .article-body :global(.ping-section--solution) {
    border-radius: 0.75rem; /* 12px */
    padding: 3.75rem; /* 60px, all sides */
    border: 1px solid oklch(57.7% 0.215 27.3deg / 50%);
    background: linear-gradient(0deg, rgba(220, 38, 38, 0.00) 0%, rgba(220, 38, 38, 0.13) 100%);
    background-origin: border-box;
    background-clip: padding-box, padding-box, border-box;
  }

  /* A heading still sits close to the content directly under it (16px),
     same as Figma's "The problem"/"The approach" heading+paragraph groups —
     this is intra-section spacing, unaffected by the section padding above. */
  .article-body :global(h2 + *) {
    margin-top: 1rem; /* 16px */
  }

  .article-body :global(h2) {
    font-family: var(--font-plex-sans);
    font-weight: 500;
    font-size: 1.5rem; /* 24px */
    line-height: 2.5rem; /* 40px */
    color: var(--portfolio-ink);
  }

  .article-body :global(p) {
    font-family: var(--font-plex-sans);
    font-size: 1.125rem; /* 18px */
    line-height: 2rem; /* 32px */
    font-weight: 300;
  }

  /* Paragraphs immediately following another paragraph (e.g. "The problem"'s
     three-paragraph run) sit tighter than the 40px inter-block gap above —
     Figma treats runs of body copy as one 16px-spaced group. */
  .article-body :global(p + p) {
    margin-top: 1rem; /* 16px */
  }

  /* Every `.ping-section` in Figma is a `flex flex-col gap-[40px]` —
     Intro's paragraphs vs. its image, Approach's copy vs. its two-image row,
     a Point's LabeledRow vs. its LoopVideo, all 40px apart regardless of
     element type. This is intra-section spacing between a section's direct
     children, distinct from `.ping-section`'s own 60px outer padding above.
     `:not(p)` keeps this from overriding the tighter 16px `p + p` run
     spacing below — a `p` following a `p` should stay at 16px, not jump to
     40px just because both happen to sit inside a `.ping-section`. */
  .article-body :global(.ping-section > * + *:not(p)) {
    margin-top: 2.5rem; /* 40px */
  }

  .article-body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-underline-position: from-font;
  }
</style>
