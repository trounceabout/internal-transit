---
// ProjectLayout.astro — wraps an individual project's case-study page.
// Adapted from BlogLayout.astro: swaps the date+tags meta row for a single
// icon+eyebrow badge, and adds a Role/Scope properties row plus a Loom embed
// (hidden until the reader opts in via "Watch the overview") that articles
// don't have.
import BaseLayout from './BaseLayout.astro';
import { Home } from 'pixelarticons/react/Home';
import { Play } from 'pixelarticons/react/Play';
import { Close } from 'pixelarticons/react/Close';
import type { ComponentType, SVGProps } from 'react';

interface Props {
  name: string;
  tagline: string;
  icon: ComponentType<SVGProps<SVGSVGElement>>;
  iconColor?: string;
  iconColorDark?: string;
  badgeColor?: string;
  badgeColorDark?: string;
  description?: string;
  accentPhrase?: string;
  loomUrl?: string;
  embedCaption?: string;
  role?: string;
  scope?: string;
}

const {
  name,
  tagline,
  icon,
  iconColor,
  iconColorDark,
  badgeColor,
  badgeColorDark,
  description,
  accentPhrase,
  loomUrl,
  embedCaption,
  role,
  scope,
} = Astro.props;

// Dek paragraph (the 24px intro copy under the headline) prefers the longer
// `description`, falling back to the shorter home-page-list `tagline` when a
// case study hasn't set one yet.
const dek = description ?? tagline;

// Same split-around-a-phrase technique as BlogLayout's accentWord, but
// colored by the project's own iconColor rather than a shared category
// config. Applied to `tagline` (the headline text), not `dek` — the
// headline and the intro paragraph below it are two separate strings.
const accentIndex = accentPhrase ? tagline.indexOf(accentPhrase) : -1;
const taglineBefore = accentIndex >= 0 ? tagline.slice(0, accentIndex) : tagline;
const taglineAfter = accentIndex >= 0 ? tagline.slice(accentIndex + (accentPhrase?.length ?? 0)) : '';

// Loom share URLs (loom.com/share/<id>) don't render embedded — the player
// requires the /embed/<id> path.
const embedSrc = loomUrl?.replace('/share/', '/embed/');

// JSX/Astro only renders a variable as a component if it starts with a
// capital letter — `icon` comes in lowercase as a prop, so it needs a
// capitalized alias before it can be used as `<Icon />` below.
const Icon = icon;
---

<BaseLayout title={name} description={tagline}>
  <main class="mx-auto max-w-[1000px] px-6 py-18">
    <article>
      <header data-animate class="flex flex-col gap-8 mb-12">
        {/* Breadcrumb: Home badge, then the project's own icon badge + eyebrow label
            (that project badge/label markup matches the home page's Work list rows) */}
        <div class="flex items-center gap-4">
          <a href="/" class="flex items-center gap-2">
            <span class="flex items-center justify-center size-7 rounded-md bg-portfolio-muted/15">
              <Home width={16} height={16} className="text-portfolio-muted" />
            </span>
            <span class="font-mono text-base text-portfolio-muted underline">Home</span>
          </a>
          <span class="text-portfolio-muted">•</span>
          <div class="flex items-center gap-2">
            <span
              class="flex items-center justify-center size-7 rounded-md shrink-0"
              style={{
                backgroundColor: 'var(--badge-color)',
                ...(badgeColor ? { '--badge-color-light': badgeColor } : {}),
                ...(badgeColorDark ? { '--badge-color-dark': badgeColorDark } : {}),
              }}
            >
              <Icon
                width={16}
                height={16}
                style={{
                  color: 'var(--icon-color)',
                  ...(iconColor ? { '--icon-color-light': iconColor } : {}),
                  ...(iconColorDark ? { '--icon-color-dark': iconColorDark } : {}),
                }}
              />
            </span>
            <p class="font-mono text-base tracking-[-0.18px] text-portfolio-ink">{name}</p>
          </div>
        </div>

        {/* Headline — accentPhrase (if set) renders italicized in the project's own iconColor */}
        <h1 class="font-redaction text-[80px] tracking-[-2.4px] leading-[0.94] text-portfolio-ink">
          {taglineBefore}
          {accentIndex >= 0 && (
            <span
              class="italic"
              style={{
                color: 'var(--icon-color)',
                ...(iconColor ? { '--icon-color-light': iconColor } : {}),
                ...(iconColorDark ? { '--icon-color-dark': iconColorDark } : {}),
              }}
            >{accentPhrase}</span>
          )}
          {taglineAfter}
        </h1>
      </header>

      {/* Body — same max-width and typography as the article template's body column */}
      <div data-animate class="max-w-[800px] flex flex-col gap-10">
        <p class="font-plex-sans text-2xl leading-10 text-portfolio-ink">
          {dek}
        </p>

        {(embedSrc || role || scope) && (
          <div class="flex flex-col gap-10">
            {/* Properties row: overview toggle + Role/Scope, all optional so
                a case study can omit any of them. */}
            <div class="flex flex-wrap gap-10 items-start">
              {embedSrc && (
                <button
                  type="button"
                  id="overview-toggle"
                  aria-expanded="false"
                  class="inline-flex items-center gap-2 shrink-0 rounded-full pl-3 pr-4 py-3 font-mono text-lg tracking-[-0.18px] text-portfolio-ink bg-[rgba(33,92,215,0.25)] transition-colors"
                >
                  <Play
                    width={24}
                    height={24}
                    className="overview-toggle-icon-play"
                  />
                  <Close
                    width={24}
                    height={24}
                    className="overview-toggle-icon-close hidden"
                  />
                  <span class="overview-toggle-label">Watch the overview</span>
                </button>
              )}

              {role && (
                <div class="flex flex-col gap-1 font-mono text-sm tracking-[-0.14px]">
                  <p class="text-portfolio-muted">Role</p>
                  <p class="text-portfolio-ink whitespace-nowrap">{role}</p>
                </div>
              )}

              {scope && (
                <div class="flex flex-col gap-1 flex-1 min-w-[240px] font-mono text-sm tracking-[-0.14px]">
                  <p class="text-portfolio-muted">Scope</p>
                  <p class="text-portfolio-ink">{scope}</p>
                </div>
              )}
            </div>

            {/* Video: collapsed by default, revealed top-to-bottom by the
                overview toggle above. The grid-rows trick animates to the
                content's natural height without any JS measuring the DOM. */}
            {embedSrc && (
              <div
                id="overview-video"
                class="grid overview-video-collapsed"
              >
                <div class="overflow-hidden min-h-0">
                  <div class="flex flex-col gap-4 pt-2">
                    <div
                      class="aspect-[1008/567] rounded-xl overflow-hidden relative"
                      style={{
                        backgroundColor: '#252525',
                        boxShadow:
                          '0px 4px 7px 0px rgba(0,0,0,0.85), 0px 1px 2px 0px rgba(0,0,0,0.5), inset 0px 0.5px 0px 0px rgba(255,255,255,0.1), inset 0px 0px 0.5px 0px rgba(255,255,255,0.3)',
                      }}
                    >
                      <iframe
                        src={embedSrc}
                        title={`${name} video walkthrough`}
                        class="absolute inset-0 size-full"
                        allow="fullscreen; picture-in-picture"
                        allowfullscreen
                        loading="lazy"
                      />
                    </div>
                    {embedCaption && (
                      <p class="font-plex-sans text-base leading-6 text-portfolio-ink">
                        {embedCaption}
                      </p>
                    )}
                  </div>
                </div>
              </div>
            )}
          </div>
        )}

        {/* Rest of the MDX body */}
        <div class="article-body font-plex-sans text-base leading-8 text-portfolio-ink">
          <slot />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  /* MDX content comes from a separately-compiled component tree (rendered via
     <Content /> in [slug].astro), so Astro's default *scoped* styles never
     attach to it — every rule here needs :global() or it silently does nothing.
     Mirrors BlogLayout.astro's identical block. */
  /* Every direct child of the body (paragraphs, headings, images, and
     case-study components like LabeledRow/LoopVideo/Postscript alike) sits
     40px apart, matching the flat 40px gap Figma uses between every
     top-level block in the case-study body. A heading is the one exception
     — it sits close to the content directly under it (16px), same as
     Figma's "The problem"/"The approach" heading+paragraph groups. */
  .article-body :global(> * + *) {
    margin-top: 2.5rem; /* 40px */
  }

  .article-body :global(h2 + *) {
    margin-top: 1rem; /* 16px */
  }

  .article-body :global(h2) {
    font-family: var(--font-plex-sans);
    font-weight: 500;
    font-size: 1.5rem; /* 24px */
    line-height: 2.5rem; /* 40px */
    color: var(--portfolio-ink);
  }

  .article-body :global(p) {
    font-family: var(--font-plex-sans);
    font-size: 1.125rem; /* 18px */
    line-height: 2rem; /* 32px */
    font-weight: 300;
  }

  /* Paragraphs immediately following another paragraph (e.g. "The problem"'s
     three-paragraph run) sit tighter than the 40px inter-block gap above —
     Figma treats runs of body copy as one 16px-spaced group. */
  .article-body :global(p + p) {
    margin-top: 1rem; /* 16px */
  }

  .article-body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-underline-position: from-font;
  }

  /* Collapsed = 0fr row (renders at zero height but stays in the layout),
     expanded = 1fr (grows to the content's natural height). Transitioning
     grid-template-rows animates height without ever measuring scrollHeight
     in JS. */
  #overview-video {
    grid-template-rows: 1fr;
    transition: grid-template-rows 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #overview-video.overview-video-collapsed {
    grid-template-rows: 0fr;
  }

  @media (prefers-reduced-motion: reduce) {
    #overview-video {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  // Same vanilla-JS toggle shape as Footer.astro's theme switcher: a plain
  // button + classList.toggle, no framework/hydration involved. The video
  // itself never unmounts — collapsing to zero height via CSS is enough,
  // and keeps the iframe's Loom player from having to reload on re-open.
  const button = document.getElementById('overview-toggle');
  const video = document.getElementById('overview-video');
  const playIcon = button?.querySelector('.overview-toggle-icon-play');
  const closeIcon = button?.querySelector('.overview-toggle-icon-close');
  const label = button?.querySelector('.overview-toggle-label');

  button?.addEventListener('click', () => {
    const isOpen = !video?.classList.contains('overview-video-collapsed');
    video?.classList.toggle('overview-video-collapsed');
    button.setAttribute('aria-expanded', String(!isOpen));
    playIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    if (label) {
      label.textContent = isOpen ? 'Watch the overview' : 'Close the overview';
    }
  });
</script>
