---
// BaseLayout.astro — the HTML shell that wraps every page.
// Import global styles here so Tailwind applies everywhere.
import "@/styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import Footer from "@/layouts/Footer.astro";

interface Props {
  title: string;
  description?: string;
  // Which nav link is the current page — controls the bold/muted styling below.
  activeNav?: "work" | "blog";
}

// Default description used when a page doesn't supply its own.
// Kept under 160 chars for SEO.
const {
  title,
  description = "Cody Keisler — product designer writing about design, craft, and the work in between.",
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Applies the dark theme before first paint so there's no flash of the
         wrong theme. Runs unhydrated/unbundled via is:inline, in document
         order, ahead of any stylesheet. Defaults to dark unless the visitor
         has explicitly chosen light before. -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var isDark = stored !== "light";
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Format: "Page Title — Cody Keisler" for inner pages.
         The em-dash separator is a common SEO/UX convention for site branding. -->
    <title>{title} — Cody Keisler</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <!-- RSS autodiscovery — browsers and feed readers will find this automatically -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog RSS Feed"
      href="/rss.xml"
    />
    {
      /* Optional extra <head> content (e.g. ProjectLayout's Loom preconnect
        hints) — a plain <link>/<meta> rendered in a page's default slot
        stays in <body> where it's written, so pages that need something in
        <head> pass it through this named slot instead. */
    }
    <slot name="head" />
  </head>
  <body class="bg-portfolio-page flex min-h-screen flex-col pt-16 font-mono">
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <script>
      import { runFadeUpStagger } from "@/lib/animations";
      runFadeUpStagger();
    </script>
    <!-- Vercel Speed Insights — tracks real user performance data -->
    <SpeedInsights />
    <!-- Vercel Analytics — tracks page views and visitor data -->
    <Analytics />
  </body>
</html>
