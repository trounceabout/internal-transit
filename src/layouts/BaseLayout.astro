---
// BaseLayout.astro — the HTML shell that wraps every page.
// Import global styles here so Tailwind applies everywhere.
import "@/styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import TopNav from "@/layouts/TopNav.astro";
import BottomNav from "@/layouts/BottomNav.astro";
import type { NavAction } from "@/layouts/BottomNav.astro";

interface Props {
  title: string;
  description?: string;
  // Hide the top nav (the start page has its own full-screen layout).
  hideTopNav?: boolean;
  // Actions for the persistent bottom bar. Omit (or pass none) for pages
  // that shouldn't show it, like the start and about pages.
  actions?: NavAction[];
}

// Default description used when a page doesn't supply its own.
// Kept under 160 chars for SEO.
const {
  title,
  description = "Cody Keisler — product designer and design engineer in Rock Hill, SC.",
  hideTopNav = false,
  actions = [],
} = Astro.props;
const hasBottomNav = actions.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Applies the dark theme before first paint so there's no flash of the
         wrong theme. Runs unhydrated/unbundled via is:inline, in document
         order, ahead of any stylesheet. Defaults to dark unless the visitor
         has explicitly chosen light before. -->
    <script is:inline>
      (function () {
        function applyTheme() {
          var stored = localStorage.getItem("theme");
          var isDark = stored !== "light";
          document.documentElement.classList.toggle("dark", isDark);
        }
        applyTheme();
        // With client-side navigation, Astro swaps <html> attributes from the
        // incoming page (which has no .dark class), so re-apply the theme
        // after every swap or the page would flash light.
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <!-- Client-side navigation (view transitions): page changes swap the DOM
         instead of reloading, so the persistent nav doesn't flash. -->
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Format: "Page Title — Cody Keisler" for inner pages.
         The em-dash separator is a common SEO/UX convention for site branding. -->
    <title>{title} — Cody Keisler</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {
      /* Optional extra <head> content (e.g. ProjectLayout's Loom preconnect
        hints) — a plain <link>/<meta> rendered in a page's default slot
        stays in <body> where it's written, so pages that need something in
        <head> pass it through this named slot instead. */
    }
    <slot name="head" />
  </head>
  <body
    class:list={[
      "bg-portfolio-page flex min-h-screen flex-col overflow-x-hidden font-mono",
      // Leave room so the fixed bottom bar never covers the end of the page.
      hasBottomNav && "pb-24",
    ]}
  >
    {hideTopNav ? null : <TopNav />}
    <div class="flex-1">
      <slot />
    </div>
    {hasBottomNav ? <BottomNav actions={actions} /> : null}
    <script>
      import { runFadeUpStagger } from "@/lib/animations";
      import { initShortcuts } from "@/lib/shortcuts";

      initShortcuts();
      // Runs on first load and again after every client-side navigation, so
      // each new page's [data-animate] elements fade in.
      document.addEventListener("astro:page-load", () => runFadeUpStagger());
    </script>
    <!-- Vercel Speed Insights — tracks real user performance data -->
    <SpeedInsights />
    <!-- Vercel Analytics — tracks page views and visitor data -->
    <Analytics />
  </body>
</html>
