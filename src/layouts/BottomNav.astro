---
// BottomNav.astro — persistent bar of context-aware actions along the bottom
// of the viewport. Each page decides which actions it offers by passing an
// `actions` list to BaseLayout; this component just renders them as
// ActionButtons. The pages that shouldn't have it (start, about) pass none,
// and BaseLayout skips rendering this component entirely.
import ActionButton from "@/components/ActionButton.astro";

export interface NavAction {
  label: string;
  // Shorter label for narrow screens.
  shortLabel?: string;
  // Keyboard key that triggers the action: "enter", "esc", or a single letter.
  shortcut: string;
  href: string;
  // Dimmed text after the label (e.g. the next project's name).
  detail?: string;
  // Start out focused (filled) when the page loads.
  autofocus?: boolean;
  // Only show while one of these case-study sections is active (space
  // separated ids in the DOM). Omit to always show. The case-study script
  // toggles the `hidden` attribute as the reader scrolls.
  sections?: string[];
}

interface Props {
  actions: NavAction[];
}

const { actions } = Astro.props;
---

<nav
  aria-label="Page actions"
  class="bottom-nav pointer-events-none fixed inset-x-0 bottom-0 z-40 pt-10 pb-5 sm:pb-[var(--bottom-offset,58px)]"
>
  <div
    style="max-width: calc(var(--page-max) + 3rem);"
    class="bottom-actions pointer-events-auto mx-auto flex w-full items-center gap-x-2 overflow-x-auto px-6 sm:gap-x-[var(--bottom-gap,1.5rem)] lg:pl-[calc(1.5rem+var(--bottom-gutter,var(--page-gutter)))]"
  >
    {
      actions.map((action) => (
        <ActionButton
          label={action.label}
          shortLabel={action.shortLabel}
          detail={action.detail}
          shortcut={action.shortcut}
          href={action.href}
          autofocus={action.autofocus}
          data-sections={action.sections?.join(" ")}
          hidden={
            action.sections ? !action.sections.includes("overview") : undefined
          }
        />
      ))
    }
  </div>
</nav>

<style>
  /* One row, never wrapping: on phones with several actions it scrolls
     sideways instead of stacking up over the page content. */
  .bottom-actions {
    scrollbar-width: none;
  }
  /* The left inset changes between case-study sections; slide rather than jump. */
  @media (prefers-reduced-motion: no-preference) {
    .bottom-actions {
      transition: padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  /* If a row is still wider than the screen, fade its right edge as a hint
     that it scrolls. (When everything fits, the fade lands on empty padding.) */
  @media (max-width: 39.99rem) {
    .bottom-actions {
      mask-image: linear-gradient(
        to right,
        black calc(100% - 2rem),
        transparent
      );
    }
  }
  .bottom-actions::-webkit-scrollbar {
    display: none;
  }
  /* A soft fade behind the bar so page content scrolling underneath it
     doesn't collide with the button labels. The gradient only paints the
     bar's own padding area; the middle of the viewport stays untouched. */
  /* Slides down out of view while reading down the page; TopNav's scroll
     script toggles data-hidden on both bars. The bar is inert while away, so
     its (invisible) buttons can't be clicked or tabbed to; the keyboard
     shortcuts still work. */
  .bottom-nav {
    transition:
      transform 0.3s ease-out,
      visibility 0.3s;
  }
  .bottom-nav[data-hidden] {
    transform: translateY(100%);
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .bottom-nav {
      transition: none;
    }
  }
  .bottom-nav {
    background-image: linear-gradient(
      to top,
      var(--portfolio-bg) 40%,
      transparent
    );
  }
</style>
