---
// Footer.astro — shared footer rendered on every page via BaseLayout.
// Left: social links. Right: theme toggle.
import { HugeiconsIcon } from "@hugeicons/react";
import {
    GithubIcon,
    FigmaIcon,
    LinkedinIcon,
} from "@hugeicons/core-free-icons";
---

<footer data-animate class="flex items-center justify-between gap-4 flex-wrap px-6 pt-8 pb-6 max-w-[1200px] mx-auto w-full">
    <p class="font-plex-sans text-sm text-portfolio-muted-2 flex flex-wrap items-center gap-x-1">
        Looking for me around the web? Find me on
        <a
            href="https://github.com/trounceabout"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-semibold hover:underline"
            style="color: #4183C4;"
        >
            <HugeiconsIcon icon={GithubIcon} size={16} color="currentColor" />
            GitHub
        </a>,
        <a
            href="https://www.figma.com/@trounceabout"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-semibold hover:underline"
            style="color: #FF3737;"
        >
            <HugeiconsIcon icon={FigmaIcon} size={16} color="currentColor" />
            Figma
        </a>, and
        <a
            href="https://www.linkedin.com/in/codykeisler/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-semibold hover:underline"
            style="color: #0077B5;"
        >
            <HugeiconsIcon icon={LinkedinIcon} size={16} color="currentColor" />
            LinkedIn
        </a>.
    </p>

    <button
        id="theme-toggle"
        type="button"
        class="flex items-center gap-1.5 font-plex-sans text-sm text-portfolio-muted-2"
    >
        <span class="hidden dark:inline">Prefer the light?</span>
        <span class="inline dark:hidden">Prefer the dark?</span>
        <span class="font-semibold underline">Switch it up</span>
    </button>
</footer>

<script>
    import { prefersReducedMotion } from '@/lib/animations';

    const button = document.getElementById('theme-toggle');

    function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    // The View Transitions API snapshots the page before and after the
    // callback runs, so the .dark toggle inside it happens instantly and the
    // browser handles showing the correct theme on each side of the sweep —
    // no manual curtain/probe elements needed. The data attribute tells the
    // global CSS (in global.css) which of the two sweep-direction keyframes
    // to play against the new-theme screenshot.
    button?.addEventListener('click', () => {
        const goingDark = !document.documentElement.classList.contains('dark');
        document.documentElement.dataset.themeSweepDirection = goingDark ? 'dark' : 'light';

        if (!document.startViewTransition || prefersReducedMotion()) {
            toggleTheme();
            return;
        }
        document.startViewTransition(() => toggleTheme());
    });
</script>
