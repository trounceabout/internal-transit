---
// Gallery.astro — every still and loop from the case study in one grid, each
// with a short label + caption (e.g. "BEFORE  Small, limited popover").
// Stills open in the shared Lightbox, same as in the deep dive.
import LightboxImage from "@/components/case-study/LightboxImage.astro";
import LoopVideo from "@/components/case-study/LoopVideo.astro";

interface GalleryItem {
  kind: "image" | "video";
  src?: string;
  webm?: string;
  mp4?: string;
  alt: string;
  label: string;
  caption: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<!-- Figma: two 442px columns with a 16px gutter; every tile is a 276px-tall crop
     with a 12px mono caption 12px below it, and rows sit 16px apart. -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    items.map((item) => (
      <figure class="m-0 flex min-w-0 flex-col gap-3">
        {item.kind === "image" && item.src ? (
          <LightboxImage
            src={item.src}
            alt={item.alt}
            flat
            ratio={item.caption ? undefined : "1440 / 882"}
          />
        ) : item.webm && item.mp4 ? (
          <LoopVideo webm={item.webm} mp4={item.mp4} flat />
        ) : null}
        {/* Figma: the whole caption is muted. A tile with a caption gets a
          semibold label; a lone label (the Overview tile) is regular. */}
        <figcaption class="text-portfolio-muted font-mono text-xs leading-4 uppercase">
          <span class:list={[item.caption && "font-semibold"]}>
            {item.label}
          </span>
          {item.caption && <span> {item.caption}</span>}
        </figcaption>
      </figure>
    ))
  }
</div>
