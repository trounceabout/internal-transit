---
// Postscript.astro — closing section every case study ends with. The three
// subheads (Why it worked / Key takeaway / Project status) are fixed across
// every project; only the row content passed in via slots changes per case
// study. Rows use their own mono/muted/narrower style here rather than
// LabeledRow's bold-Plex-Sans solution-section look — same label+value
// shape, different visual treatment per Figma.
// The divider rule is colored per-project (like the headline's accent
// phrase and icon badge) rather than a fixed site color, via the same
// --icon-color-light/-dark custom-property pattern ProjectLayout.astro
// already uses — see global.css's [style*="--icon-color-light"] rules.
interface Props {
  iconColor?: string;
  iconColorDark?: string;
}

const { iconColor, iconColorDark } = Astro.props;
---

<section class="flex flex-col gap-6 py-15">
  <div class="flex w-full items-center gap-6">
    <span
      class="postscript-heading text-portfolio-ink m-0 font-mono text-[32px] leading-[0.94] font-normal tracking-[-0.96px] italic"
    >
      The postscript
    </span>
    <div
      class="h-px flex-1"
      style={{
        backgroundColor: "var(--icon-color)",
        ...(iconColor ? { "--icon-color-light": iconColor } : {}),
        ...(iconColorDark ? { "--icon-color-dark": iconColorDark } : {}),
      }}
    >
    </div>
  </div>

  <div class="flex w-full flex-col gap-8 text-lg">
    <div
      class="flex w-full flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6"
    >
      <p
        class="text-portfolio-muted w-full shrink-0 font-mono leading-[1.4] tracking-[-0.18px] sm:w-[200px]"
      >
        Why it worked
      </p>
      <div
        class="font-plex-sans text-portfolio-ink min-w-0 flex-1 leading-8 font-light [&_p]:mb-4 [&_p:last-child]:mb-0"
      >
        <slot name="why-it-worked" />
      </div>
    </div>
    <div class="flex w-full flex-col items-start gap-2 sm:flex-row sm:gap-6">
      <p
        class="text-portfolio-muted w-full shrink-0 font-mono leading-[1.4] tracking-[-0.18px] sm:w-[200px]"
      >
        Key takeaway
      </p>
      <div
        class="font-plex-sans text-portfolio-ink min-w-0 flex-1 leading-8 font-light [&_p]:mb-4 [&_p:last-child]:mb-0"
      >
        <slot name="key-takeaway" />
      </div>
    </div>
    <div class="flex w-full flex-col items-start gap-2 sm:flex-row sm:gap-6">
      <p
        class="text-portfolio-muted w-full shrink-0 font-mono leading-[1.4] tracking-[-0.18px] sm:w-[200px]"
      >
        Project status
      </p>
      <div
        class="font-plex-sans text-portfolio-ink min-w-0 flex-1 leading-8 font-light"
      >
        <slot name="project-status" />
      </div>
    </div>
  </div>
</section>

<style>
  /* Figma calls out fontFeatureSettings "salt" 1 on this heading — IBM Plex
     Mono's stylistic-alternates set, which swaps in the single-story italic
     'a'/'g' etc. that make the italic read as a genuine alternate face
     rather than just a slanted version of the upright glyphs. Plain
     `italic` alone doesn't turn this feature on. */
  .postscript-heading {
    font-feature-settings: "salt" 1;
  }
</style>
