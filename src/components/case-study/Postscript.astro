---
// Postscript.astro — closing section every case study ends with (Figma
// "Takeaways"). Three rows (Why it worked / Key takeaway / Project status),
// each a hairline divider, then a small icon + mono label on the left and the
// copy on the right. The three labels are fixed across every project; only the
// row content passed in via slots changes.
// The icons pick up the project color through --icon-color, like the headline's
// accent phrase; `iconColor`/`iconColorDark` let a caller override it.
import { CircleQuestion } from "pixelarticons/react/CircleQuestion";
import { Key } from "pixelarticons/react/Key";
import { XpBar } from "pixelarticons/react/XpBar";

interface Props {
  iconColor?: string;
  iconColorDark?: string;
}

const { iconColor, iconColorDark } = Astro.props;

const colorVars = {
  ...(iconColor ? { "--icon-color-light": iconColor } : {}),
  ...(iconColorDark ? { "--icon-color-dark": iconColorDark } : {}),
};
---

<section class="postscript" style={colorVars}>
  <div class="row">
    <div class="label">
      <CircleQuestion width={16} height={16} />
      <span>Why it worked</span>
    </div>
    <div class="copy"><slot name="why-it-worked" /></div>
  </div>
  <div class="row">
    <div class="label">
      <Key width={16} height={16} />
      <span>Key takeaway</span>
    </div>
    <div class="copy"><slot name="key-takeaway" /></div>
  </div>
  <div class="row">
    <div class="label">
      <XpBar width={16} height={16} />
      <span>Project status</span>
    </div>
    <div class="copy"><slot name="project-status" /></div>
  </div>
</section>

<style>
  .postscript {
    padding-top: 60px;
  }
  /* Divider above each row: ink at 14% (Figma: cream at 14%). */
  .row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 0;
    border-top: 1px solid
      color-mix(in srgb, var(--portfolio-ink) 14%, transparent);
  }
  @media (min-width: 40rem) {
    .row {
      flex-direction: row;
      gap: 40px;
    }
  }
  /* 16px icon, 8px gap, then a 180px-wide label: a 204px column. */
  .label {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
    height: 20px;
    color: var(--portfolio-muted);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    text-transform: uppercase;
  }
  @media (min-width: 40rem) {
    .label {
      width: 204px;
    }
  }
  .label :global(svg) {
    flex: none;
    color: var(--icon-color);
  }
  .copy {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: 16px;
    font-family: var(--font-plex-sans);
    font-size: 18px;
    font-weight: 400;
    line-height: 28px;
    color: var(--portfolio-ink);
  }
  /* The article's own paragraph rules (light 18/32, with extra margins) are
     meant for the long-form copy above; the takeaways use their own rhythm. */
  .postscript .copy :global(p),
  .postscript .copy :global(p + p) {
    margin: 0;
    font-weight: 400;
    line-height: 28px;
  }
  /* MDX wraps a slotted <Fragment> in an empty paragraph; it would add a gap. */
  .postscript .copy :global(p:empty) {
    display: none;
  }
</style>
