---
// SubNav.astro — the case study's side navigation (Figma "Sub-nav").
//
// Four top-level items: Overview, Deep dive, Walkthrough, Gallery. "Deep dive"
// owns sub-items (Intro, The problem, ...) that only expand while the reader
// is inside that section. The script in src/lib/caseStudy.ts keeps this in
// sync with scrolling: it sets `data-active-section` on this <nav> (which the
// CSS below uses to expand the sub-items) and `aria-current` on the links.
interface Props {
  hasWalkthrough?: boolean;
  hasGallery?: boolean;
}

const { hasWalkthrough = true, hasGallery = true } = Astro.props;

// The ids match the `id`s on the corresponding blocks in the MDX body.
const deepDiveItems = [
  { id: "intro", label: "Intro" },
  { id: "problem", label: "The problem" },
  { id: "solution", label: "The solution" },
  { id: "approach", label: "The approach" },
  { id: "examples", label: "Examples" },
  { id: "postscript", label: "Postscript" },
];
---

<nav
  aria-label="Case study sections"
  data-subnav
  class="subnav font-mono text-sm"
>
  <a href="#overview" data-section-link="overview" class="subnav-link">
    Overview
  </a>

  <a href="#deep-dive" data-section-link="deep-dive" class="subnav-link">
    Deep dive
  </a>
  <!-- Sub-items. The grid-rows 0fr -> 1fr trick animates height without
       knowing it: the inner wrapper has overflow hidden and min-height 0. -->
  <div class="subnav-children">
    <ul class="subnav-tree m-0 list-none p-0">
      {
        deepDiveItems.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-sub-link={item.id}
              class="subnav-link subnav-sublink"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    hasWalkthrough && (
      <a
        href="#walkthrough"
        data-section-link="walkthrough"
        class="subnav-link"
      >
        Walkthrough
      </a>
    )
  }
  {
    hasGallery && (
      <a href="#gallery" data-section-link="gallery" class="subnav-link">
        Gallery
      </a>
    )
  }
</nav>

<style>
  .subnav {
    --subnav-line: color-mix(in srgb, var(--portfolio-ink) 85%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 260px;
  }

  .subnav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--portfolio-muted);
    transition:
      background-color 0.2s ease-out,
      color 0.2s ease-out;
  }
  .subnav-link:hover {
    color: var(--portfolio-ink);
  }
  .subnav-link:focus {
    outline: none;
  }
  .subnav-link:focus-visible {
    outline: 2px solid var(--portfolio-ink);
    outline-offset: -2px;
  }
  /* Current top-level item: tinted pill, bold + full ink color. */
  .subnav-link[aria-current="true"] {
    background-color: var(--portfolio-nav-active);
    color: var(--portfolio-ink);
    font-weight: 600;
    /* Figma's pill has stepped, pixel-style corners (6px deep, in 1.5 / 1.5 / 3px
       bands) rather than a smooth radius. */
    border-radius: 0;
    clip-path: polygon(
      6px 0,
      calc(100% - 6px) 0,
      calc(100% - 6px) 1.5px,
      calc(100% - 4px) 1.5px,
      calc(100% - 4px) 3px,
      calc(100% - 2px) 3px,
      calc(100% - 2px) 6px,
      100% 6px,
      100% calc(100% - 6px),
      calc(100% - 2px) calc(100% - 6px),
      calc(100% - 2px) calc(100% - 3px),
      calc(100% - 4px) calc(100% - 3px),
      calc(100% - 4px) calc(100% - 1.5px),
      calc(100% - 6px) calc(100% - 1.5px),
      calc(100% - 6px) 100%,
      6px 100%,
      6px calc(100% - 1.5px),
      4px calc(100% - 1.5px),
      4px calc(100% - 3px),
      2px calc(100% - 3px),
      2px calc(100% - 6px),
      0 calc(100% - 6px),
      0 6px,
      2px 6px,
      2px 3px,
      4px 3px,
      4px 1.5px,
      6px 1.5px
    );
  }

  /* ─── Deep dive sub-items ───────────────────────────────────────────────── */
  .subnav-children {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: -0.5rem; /* cancels the flex gap so a collapsed list adds no space */
    transition: grid-template-rows 0.3s ease-out;
  }
  .subnav-tree {
    min-height: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    visibility: hidden;
    transition: visibility 0.3s;
  }
  .subnav[data-active-section="deep-dive"] .subnav-children {
    grid-template-rows: 1fr;
    margin-top: 0;
  }
  .subnav[data-active-section="deep-dive"] .subnav-tree {
    visibility: visible;
  }

  /* Tree connector (Figma: a 1px line at x=13, with a rounded elbow leading into
     each sub-item). The line runs from just inside the first item to where the
     last elbow starts; each elbow is a 12px box with a left and bottom edge. */
  .subnav-tree::before {
    content: "";
    position: absolute;
    left: 13px;
    top: 2px;
    bottom: 29px;
    width: 1px;
    background: var(--subnav-line);
  }
  .subnav-sublink {
    position: relative;
    padding-left: 2rem;
  }
  .subnav-sublink::before {
    content: "";
    position: absolute;
    left: 13px;
    top: 5px;
    width: 12px;
    height: 12.5px;
    border-left: 1px solid var(--subnav-line);
    border-bottom: 1px solid var(--subnav-line);
    border-bottom-left-radius: 4px;
  }
  /* Current sub-item: bold ink, no pill (the pill belongs to "Deep dive"). */
  .subnav-sublink[aria-current="true"] {
    background-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .subnav-link,
    .subnav-children,
    .subnav-tree {
      transition: none;
    }
  }
</style>
