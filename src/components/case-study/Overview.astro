---
// Overview.astro — the case study's opening "presentation": a big icon tile,
// the project name, an oversized headline with the accent phrase tinted in
// the project color, the description, and the key facts. Meant to feel larger
// than life; the section's own buttons live in the bottom nav (Deep dive /
// Walkthrough / Gallery), which jump straight to those sections.
//
// The `data-ov` attributes are hooks for the entrance animation in
// src/lib/caseStudy.ts (built with Motion).
import type { ComponentType, SVGProps } from "react";
import { Play } from "pixelarticons/react/Play";
import { Reload } from "pixelarticons/react/Reload";

interface Props {
  name: string;
  tagline: string;
  accentPhrase?: string;
  description?: string;
  icon: ComponentType<SVGProps<SVGSVGElement>>;
  type?: string;
  role?: string;
  scope?: string;
  hasWalkthrough?: boolean;
}

const {
  name,
  tagline,
  accentPhrase,
  description,
  icon: Icon,
  type,
  role,
  scope,
  hasWalkthrough,
} = Astro.props;

// Split the headline into words (so each can animate in on its own), marking
// the words that fall inside the accent phrase.
const accentStart = accentPhrase ? tagline.indexOf(accentPhrase) : -1;
const accentEnd =
  accentStart >= 0 ? accentStart + (accentPhrase?.length ?? 0) : -1;
let cursor = 0;
const words = tagline.split(" ").map((text) => {
  const start = cursor;
  cursor += text.length + 1;
  const accent = accentStart >= 0 && start >= accentStart && start < accentEnd;
  return { text, accent };
});
---

<div class="flex flex-col items-start gap-6">
  <div class="flex items-center gap-5">
    <span
      data-ov="tile"
      class="overview-tile flex size-20 items-center justify-center rounded-2xl"
    >
      <Icon width={36} height={36} />
    </span>
    <p data-ov="name" class="text-portfolio-ink font-mono text-2xl">{name}</p>
  </div>

  <h1 class="overview-headline m-0">
    {
      words.map(({ text, accent }) => (
        <span
          data-ov="word"
          class:list={["inline-block", accent && "italic"]}
          style={accent ? "color: var(--icon-color);" : undefined}
        >
          {text}&nbsp;
        </span>
      ))
    }
  </h1>

  {
    description && (
      <p
        data-ov="desc"
        class="font-plex-sans text-portfolio-ink max-w-[38rem] text-lg leading-8"
      >
        {description}
      </p>
    )
  }

  <dl data-ov="meta" class="m-0 flex flex-wrap gap-x-12 gap-y-6">
    {
      type && (
        <div class="flex flex-col gap-2">
          <dt class="meta-label">Type</dt>
          <dd class="meta-badge m-0">
            <Reload width={16} height={16} />
            {type}
          </dd>
        </div>
      )
    }
    {
      hasWalkthrough && (
        <div class="flex flex-col gap-2">
          <dt class="meta-label">Accessories</dt>
          <dd class="meta-badge m-0">
            <Play width={16} height={16} />
            Video walkthrough
          </dd>
        </div>
      )
    }
    {
      role && (
        <div class="flex flex-col gap-2">
          <dt class="meta-label">Role</dt>
          <dd class="meta-value">{role}</dd>
        </div>
      )
    }
    {
      scope && (
        <div class="flex max-w-[28rem] flex-col gap-2">
          <dt class="meta-label">Scope</dt>
          <dd class="meta-value">{scope}</dd>
        </div>
      )
    }
  </dl>
</div>

<style>
  .overview-tile {
    background-color: var(--icon-color);
    /* Cream icon on the project color in both themes (same as the home tile). */
    color: #fff9f2;
    box-shadow: var(--media-frame-shadow);
  }

  /* The oversized Redaction headline — one step bigger than .portfolio-headline
     since the overview is meant to feel like a title slide. The min() with vh
     keeps it from outgrowing short windows (laptops), where the whole overview
     should still fit on one screen. */
  .overview-headline {
    font-family: var(--font-redaction);
    font-size: clamp(2.75rem, min(1.4rem + 5vw, 8.5vh), 6rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    color: var(--portfolio-ink);
    font-weight: 400;
  }

  .meta-label {
    font-family: var(--font-plex-sans);
    font-size: 0.875rem;
    text-transform: uppercase;
    color: var(--portfolio-muted);
    letter-spacing: 0.02em;
  }
  .meta-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    color: var(--portfolio-ink);
    line-height: 1.65;
  }
  .meta-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.5rem;
    border-radius: 0.25rem;
    padding: 0.25rem 0.5rem;
    background-color: var(--badge-color, var(--portfolio-keycap));
    color: var(--portfolio-ink);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .meta-badge :global(svg) {
    color: var(--icon-color);
  }
</style>
