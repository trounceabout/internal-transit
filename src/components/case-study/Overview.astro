---
// Overview.astro — the case study's opening "presentation" (Figma: the
// "Project — Detail" frames). From top to bottom:
//   1. a centered hero: per-project artwork, an oversized headline with the
//      accent phrase in the project color, and a small project chip
//   2. the description
//   3. a two-column row: an action menu (Read deep dive / Watch walkthrough /
//      View gallery) on the left, the project's type, role and scope on the right
//
// The menu items are real buttons with keyboard shortcuts (Enter / W / G), so
// they don't need entries in the bottom nav. The `data-ov` attributes are hooks
// for the entrance animation in src/lib/caseStudy.ts (built with Motion).
import type { ComponentType, SVGProps } from "react";
import { Play } from "pixelarticons/react/Play";
import ActionButton from "@/components/ActionButton.astro";
import HeroArt from "@/components/case-study/hero/HeroArt.astro";
import { slashList, typeIcon } from "@/lib/projectMeta";

interface Props {
  name: string;
  tagline: string;
  accentPhrase?: string;
  description?: string;
  icon: ComponentType<SVGProps<SVGSVGElement>>;
  heroArt?: "toasts" | "mark" | "cpu-card";
  type?: string;
  role?: string;
  scope?: string;
  hasWalkthrough?: boolean;
  hasGallery?: boolean;
}

const {
  name,
  tagline,
  accentPhrase,
  description,
  icon: Icon,
  heroArt,
  type,
  role,
  scope,
  hasWalkthrough,
  hasGallery,
} = Astro.props;

const TypeIcon = type ? typeIcon(type) : null;

// Split the headline into words (so each can animate in on its own), marking
// the words that fall inside the accent phrase.
const accentStart = accentPhrase ? tagline.indexOf(accentPhrase) : -1;
const accentEnd =
  accentStart >= 0 ? accentStart + (accentPhrase?.length ?? 0) : -1;
let cursor = 0;
const words = tagline.split(" ").map((text) => {
  const start = cursor;
  cursor += text.length + 1;
  const accent = accentStart >= 0 && start >= accentStart && start < accentEnd;
  return { text, accent };
});
---

<div class="overview">
  <div class="hero">
    <HeroArt art={heroArt} />

    <div class="hero-title">
      <h1 class="overview-headline m-0">
        {
          words.map(({ text, accent }) => (
            <span
              data-ov="word"
              class:list={["inline-block", accent && "italic"]}
              style={accent ? "color: var(--icon-color);" : undefined}
            >
              {text}&nbsp;
            </span>
          ))
        }
      </h1>

      <div data-ov="name" class="project-chip">
        <span class="chip-tile">
          <Icon width={15} height={15} />
        </span>
        <span class="chip-name">{name}</span>
      </div>
    </div>
  </div>

  <div class="overview-body">
    {
      description && (
        <p data-ov="desc" class="overview-description">
          {description}
        </p>
      )
    }

    <div data-ov="meta" class="overview-row">
      <div class="action-menu">
        <ActionButton
          block
          autofocus
          label="Read deep dive"
          shortcut="enter"
          href="#deep-dive"
        />
        {
          hasWalkthrough && (
            <ActionButton
              block
              label="Watch walkthrough"
              shortcut="w"
              href="#walkthrough"
            />
          )
        }
        {
          hasGallery && (
            <ActionButton
              block
              label="View gallery"
              shortcut="g"
              href="#gallery"
            />
          )
        }
      </div>

      <div class="overview-details">
        <div class="chip-row">
          {
            type && TypeIcon && (
              <span class="meta-badge">
                <TypeIcon width={16} height={16} />
                {type}
              </span>
            )
          }
          {
            hasWalkthrough && (
              <span class="meta-badge">
                <Play width={14} height={14} />
                Video walkthrough
              </span>
            )
          }
        </div>
        {
          role && (
            <div class="detail">
              <p class="detail-label">Role</p>
              <p class="detail-value">{slashList(role)}</p>
            </div>
          )
        }
        {
          scope && (
            <div class="detail">
              <p class="detail-label">Scope</p>
              <p class="detail-value detail-value--wrap">{slashList(scope)}</p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .overview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    width: 100%;
  }

  /* ─── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 888px;
  }
  .hero-title {
    position: relative; /* so the headline can sit over a CPU card behind it */
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    width: 100%;
  }
  /* Redaction 35 at 72px, 0.94 line height, -2.16px tracking, centered. */
  .overview-headline {
    max-width: 888px;
    text-align: center;
    font-family: var(--font-redaction);
    font-size: clamp(2.75rem, 1.2rem + 4.8vw, 4.5rem);
    font-weight: 400;
    line-height: 0.9444; /* 68px at 72px: two lines are 136px tall, as in Figma */
    letter-spacing: -0.03em;
    color: var(--portfolio-ink);
  }

  /* "Project Ping": a 24px tile in the project's tint, then the name. */
  .project-chip {
    display: flex;
    align-items: center;
    gap: 12.8px;
  }
  .chip-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background-color: color-mix(in srgb, var(--icon-color) 15%, transparent);
    color: var(--icon-color);
  }
  .chip-name {
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.16px;
    color: var(--portfolio-ink);
  }

  /* ─── Body ─────────────────────────────────────────────────────────────── */
  .overview-body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 900px;
  }
  .overview-description {
    margin: 0;
    font-family: var(--font-plex-sans);
    font-size: 18px;
    line-height: 28px;
    color: color-mix(in srgb, var(--portfolio-ink) 85%, transparent);
  }
  /* Stacked on small screens; side by side (360px menu, 80px gap) from lg. */
  .overview-row {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media (min-width: 64rem) {
    .overview-row {
      flex-direction: row;
      gap: 80px;
    }
    .action-menu {
      flex: none;
      width: 360px;
    }
    .overview-details {
      flex: 1 1 0;
      min-width: 0;
    }
  }
  .action-menu {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ─── Details ──────────────────────────────────────────────────────────── */
  .overview-details {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* The same chips as the Projects page: project tint, fully rounded. */
  .meta-badge {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--icon-color) 15%, transparent);
    color: var(--portfolio-ink);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    line-height: normal;
  }
  .meta-badge :global(svg) {
    color: var(--icon-color);
  }
  /* A label stacked over its value, 8px apart. */
  .detail {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .detail-label,
  .detail-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: normal;
    text-transform: uppercase;
  }
  .detail-label {
    color: var(--portfolio-muted);
  }
  .detail-value {
    color: var(--portfolio-ink);
  }
  .detail-value--wrap {
    line-height: 24px;
  }
</style>
