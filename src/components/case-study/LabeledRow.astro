---
// LabeledRow.astro — the "From X to Y" solution sub-section pattern: a bold
// Plex Sans label in a fixed-width column next to the Plex Sans body copy.
// Postscript.astro's rows look similar but use a different font/color/width
// (mono, muted, narrower), so they're styled separately there rather than
// forcing one component to cover both shapes.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="flex w-full flex-col items-start gap-4 sm:flex-row">
  <span
    class="font-plex-sans text-portfolio-ink w-full shrink-0 text-lg leading-8 font-semibold sm:w-[248px]"
  >
    {label}
  </span>
  <div
    class="font-plex-sans text-portfolio-ink min-w-0 flex-1 text-lg leading-8 font-light [&_p]:mb-4 [&_p:last-child]:mb-0"
  >
    <slot />
  </div>
</div>
