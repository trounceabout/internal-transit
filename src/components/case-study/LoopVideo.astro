---
// LoopVideo.astro — silent, looping, autoplaying inline video used to
// illustrate a case-study beat. Shares the same rounded/shadow "media frame"
// treatment as ProjectLayout's Loom embed box and the static screenshots
// elsewhere in a case study, so all inline media reads as one visual family.
import { MEDIA_FRAME_SHADOW } from "@/lib/media";

interface Props {
  webm: string;
  mp4: string;
  caption?: string;
}

const { webm, mp4, caption } = Astro.props;
---

<figure class="m-0 flex flex-col gap-4">
  <div
    class="relative overflow-hidden rounded-lg"
    style={{ boxShadow: MEDIA_FRAME_SHADOW }}
  >
    <video class="block h-auto w-full" autoplay loop muted playsinline>
      <source src={webm} type="video/webm" />
      <source src={mp4} type="video/mp4" />
    </video>
  </div>
  {
    caption && (
      <figcaption class="font-plex-sans text-portfolio-text text-base leading-6">
        {caption}
      </figcaption>
    )
  }
</figure>
