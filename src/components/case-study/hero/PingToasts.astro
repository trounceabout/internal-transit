---
// PingToasts.astro — the Ping Overview's hero: four toast notifications fanned
// into a stack, each one a little wider and lower than the one behind it (a
// warning, an error with a Retry button, a success, and a "rebooting" toast).
//
// Everything is positioned absolutely at Figma's exact coordinates inside a
// 465.77 x 181.19 box. The toasts are a picture of the product UI (the
// Undercurrent design system's Toast), so they're white cards with their own
// fixed colors in both themes rather than using the site's theme tokens.
const toasts = [
  {
    // warning
    x: 65.098,
    y: 0,
    w: 335.576,
    h: 69.186,
    border: 1.699,
    color: "#ca8a04",
    radius: 10.195,
    pad: 13.593,
    icon: 20.389,
    gap: 6.796,
    font: 11.894,
    line: 20.389,
    shadow: "0 0 0.425px rgba(0,0,0,0.12), 0 5.097px 8.496px rgba(0,0,0,0.2)",
    iconColor: "#ca8a04",
    title: "Server rebooting...",
    kind: "alert",
  },
  {
    // error, with a Retry button
    x: 41.576,
    y: 18.677,
    w: 382.62,
    h: 78.997,
    border: 1.937,
    color: "#f87171",
    radius: 11.624,
    pad: 15.499,
    icon: 23.248,
    gap: 7.749,
    font: 13.561,
    line: 23.248,
    shadow: "0 0 0.484px rgba(0,0,0,0.12), 0 5.812px 9.687px rgba(0,0,0,0.2)",
    iconColor: "#dc2626",
    title: "Reimaging failed",
    kind: "x",
    retry: true,
  },
  {
    // success
    x: 18.081,
    y: 47.164,
    w: 429.609,
    h: 88.804,
    border: 2.175,
    color: "#16a34a",
    radius: 13.051,
    pad: 17.402,
    icon: 26.103,
    gap: 8.701,
    font: 15.227,
    line: 26.103,
    shadow: "0 0 0.544px rgba(0,0,0,0.12), 0 6.526px 10.876px rgba(0,0,0,0.2)",
    iconColor: "#16a34a",
    title: "Firewall rules updated",
    kind: "check",
  },
  {
    // in progress (front)
    x: 0,
    y: 85.459,
    w: 465.772,
    h: 95.733,
    border: 2.358,
    color: "#a5b4fc",
    radius: 14.15,
    pad: 18.867,
    icon: 28.3,
    gap: 9.433,
    font: 16.508,
    line: 28.3,
    shadow: "0 0 0.59px rgba(0,0,0,0.12), 0 7.075px 11.792px rgba(0,0,0,0.2)",
    iconColor: "#6366f1",
    title: "Server rebooting...",
    kind: "loader",
  },
];
---

<div class="toast-stack" aria-hidden="true">
  {
    toasts.map((t) => (
      <div
        class="toast"
        style={`left:${t.x}px;top:${t.y}px;width:${t.w}px;height:${t.h}px;border:${t.border}px solid ${t.color};border-radius:${t.radius}px;padding:${t.pad}px;gap:${t.pad}px;box-shadow:${t.shadow};`}
      >
        <div class="toast-content" style={`gap:${t.gap}px;`}>
          <svg
            class="toast-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke={t.iconColor}
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style={`width:${t.icon}px;height:${t.icon}px;`}
          >
            {t.kind === "alert" && (
              <>
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
              </>
            )}
            {t.kind === "x" && (
              <>
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
              </>
            )}
            {t.kind === "check" && <path d="M20 6 9 17l-5-5" />}
            {t.kind === "loader" && <path d="M21 12a9 9 0 1 1-6.219-8.56" />}
          </svg>
          <div
            class="toast-text"
            style={`font-size:${t.font}px;line-height:${t.line}px;`}
          >
            <p class="toast-title">{t.title}</p>
            <p class="toast-sub">cold-parent-duo.metalseed.io</p>
          </div>
        </div>
        {t.retry && (
          <span
            class="toast-retry"
            style={`padding:${t.gap}px;gap:${t.gap}px;`}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="rgba(255,255,255,0.9)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="width:15.499px;height:15.499px;"
            >
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
            </svg>
            Retry
          </span>
        )}
      </div>
    ))
  }
</div>

<style>
  .toast-stack {
    position: relative;
    width: 465.772px;
    height: 181.192px;
  }
  .toast {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    background: #ffffff;
    font-family: "Geist Sans", sans-serif;
  }
  /* Icon + two-line message, sharing a smaller gap than the toast's own
     content-to-button gap. */
  .toast-content {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: flex-start;
  }
  .toast-icon {
    flex: none;
  }
  .toast-text {
    flex: 1 1 0;
    min-width: 0;
  }
  .toast-title,
  .toast-sub {
    margin: 0;
    white-space: nowrap;
  }
  .toast-title {
    font-weight: 500;
    color: #171717;
  }
  .toast-sub {
    font-weight: 400;
    color: #525252;
  }
  /* The "Retry" pill on the error toast: dark, fully rounded. */
  .toast-retry {
    flex: none;
    display: inline-flex;
    align-items: center;
    align-self: center;
    box-sizing: border-box;
    border-radius: 9999px;
    background: #171717;
    color: rgba(255, 255, 255, 0.9);
    font-size: 12.593px;
    font-weight: 500;
    line-height: 12.593px;
    letter-spacing: 0.063px;
  }
</style>
