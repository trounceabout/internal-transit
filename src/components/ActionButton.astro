---
// ActionButton.astro — the button from Figma's "New buttons" section:
// transparent at rest, and the one button that has focus is filled with the
// theme's ink color (text flips to the page color) and lifts with the shared
// --media-frame-shadow. There is no separate "primary" variant: a page marks the
// button that should start out focused with `autofocus`, and the arrow keys and
// mouse hover (src/lib/shortcuts.ts) move the focus, and with it the fill,
// between buttons. A small key-cap tile on the right tells the visitor which
// keyboard key triggers the same action.
//
// Renders an <a> when `href` is given, otherwise a <button>.
//
// Keyboard shortcuts: pass `shortcut`. We stamp it on the element as
// `data-shortcut`, and the single global listener in src/lib/shortcuts.ts
// finds the element and clicks it. That means a page never wires up key
// handlers itself — it only declares buttons.
import { ArrowReturnLeft } from "pixelarticons/react/ArrowReturnLeft";

interface Props {
  label: string;
  // Shorter text used instead of `label` below the sm breakpoint, where space
  // is tight (e.g. "Walkthrough" for "Watch walkthrough").
  shortLabel?: string;
  // Dimmed text after the label, e.g. the next project's name.
  detail?: string;
  // "enter" and "esc" get their special glyphs; anything else is shown as an
  // uppercase single character (e.g. "x", "w").
  shortcut?: "enter" | "esc" | (string & {});
  href?: string;
  // Start out focused (and so filled) when the page loads. Only one button per
  // page should set this; shortcuts.ts does the focusing.
  autofocus?: boolean;
  // The large, full-width "menu item" form used in the case-study Overview:
  // 18px text, a pill with 16px/12px padding, label on the left and the key
  // tile pushed to the far right.
  block?: boolean;
  hidden?: boolean;
  class?: string;
  id?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const {
  label,
  shortLabel,
  detail,
  shortcut,
  href,
  autofocus = false,
  block = false,
  class: className,
  id,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const keyName = shortcut?.toLowerCase();
---

<Tag
  id={id}
  href={href}
  type={href ? undefined : "button"}
  data-shortcut={keyName}
  data-autofocus={autofocus ? "" : undefined}
  class:list={[
    "action-button text-portfolio-ink inline-flex shrink-0 cursor-pointer items-center font-mono whitespace-nowrap",
    block
      ? // Large menu item: 360px-ish pill, label left, key tile right. Weight and
        // color (regular at 80% ink, medium at full strength when focused) are
        // set in the styles below.
        "w-full justify-between gap-3 rounded-md px-4 py-3 text-lg leading-[normal]"
      : [
          "text-base font-medium",
          // Figma: the Enter button is 12px/8px padding with a 4px icon gap
          // (the arrow sits right against the label); the others are 8px
          // padding with a 12px gap. Set by key, not by focus, so the buttons
          // never change size when the focus moves.
          keyName === "enter" ? "gap-1 px-3 py-2" : "gap-3 p-2",
          // Every button has 8px corners.
          "rounded-md",
        ],
    block && "is-block",
    className,
  ]}
  {...rest}
>
  {
    shortcut && (
      <span
        aria-hidden="true"
        class:list={[
          "keycap bg-portfolio-keycap flex h-6 items-center justify-center rounded-sm",
          // The key tile always sits after the label (at the far right in the
          // block form).
          "order-last",
          // ESC is three letters wide; every other key is a square tile.
          keyName === "esc" ? "w-10 text-xs tracking-wider" : "w-6",
        ]}
      >
        {keyName === "enter" ? (
          <ArrowReturnLeft width={18} height={18} />
        ) : keyName === "esc" ? (
          "ESC"
        ) : (
          <span class="text-sm">{keyName?.toUpperCase()}</span>
        )}
      </span>
    )
  }
  <span>
    {
      shortLabel ? (
        <>
          <span class="max-sm:hidden">{label}</span>
          <span class="sm:hidden">{shortLabel}</span>
        </>
      ) : (
        label
      )
    }
    {detail && <span class="action-detail"> {detail}</span>}
  </span>
</Tag>

<style>
  .action-button {
    background-color: transparent;
    box-shadow: none;
    /* The transition lives on the resting selector, not :active, so it plays
       on press AND on release. */
    transition:
      transform 0.15s ease-out,
      box-shadow 0.15s ease-out,
      background-color 0.15s ease-out,
      color 0.15s ease-out;
  }

  /* The filled look IS the focus state: no outline, the fill is the indicator.
     shortcuts.ts moves focus with the arrow keys and on mouse hover, so exactly
     one button is filled at a time. */
  .action-button:focus {
    outline: none;
  }

  .action-button:focus {
    background-color: var(--portfolio-ink);
    color: var(--portfolio-bg);
    box-shadow: var(--media-frame-shadow);
  }

  /* The large Overview menu items rest at regular weight and 80% ink, and step
     up to medium weight and full-strength ink when focused. (Monospace, so the
     heavier weight doesn't change the width.) */
  .action-button.is-block {
    font-weight: 400;
    color: color-mix(in srgb, var(--portfolio-ink) 80%, transparent);
  }
  .action-button.is-block:focus {
    font-weight: 500;
    color: var(--portfolio-bg);
  }

  /* While the button is filled with ink, the key-cap and the dimmed detail
     text need to follow the inverted colors, or they'd vanish. */
  .action-button:focus :global(.bg-portfolio-keycap) {
    background-color: color-mix(in srgb, var(--portfolio-bg) 18%, transparent);
  }
  /* Figma shows the Enter arrow directly on the fill, with no tile behind it. */
  .action-button[data-shortcut="enter"]:focus :global(.bg-portfolio-keycap) {
    background-color: transparent;
  }
  /* Resting color: Figma dims the project name to the page ink at 50%, which is
     fainter than the shared muted token. */
  .action-detail {
    color: color-mix(in srgb, var(--portfolio-ink) 50%, transparent);
  }
  .action-button:focus .action-detail {
    color: color-mix(in srgb, var(--portfolio-bg) 55%, transparent);
  }

  /* "Depress on click": shrink slightly and collapse the shadow so the
     button sinks toward the page. */
  .action-button:active {
    transform: scale(0.97);
    box-shadow: var(--button-shadow-pressed);
  }

  /* No keyboard to show shortcuts for: on touch devices and very narrow
     screens the key-cap is dropped (the action still works by tapping), and
     the button gets a little more side padding so the label doesn't crowd. */
  @media (hover: none), (max-width: 39.99rem) {
    .action-button :global(.keycap) {
      display: none;
    }
    /* The compact bottom-nav buttons shrink; the large Overview menu items keep
       their size. */
    .action-button:not(.is-block) {
      gap: 0;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action-button {
      transition: none;
    }
    .action-button:active {
      transform: none;
    }
  }
</style>
