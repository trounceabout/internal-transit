---
// ProjectShowcase.astro — the home page: a row of large project icon buttons
// ("cartridges") across the top, and a preview of the selected project under it.
//
// Each project has its own URL (/home/<slug>), and /home itself shows the
// first project. Selecting an icon is an ordinary link click handled by
// Astro's client-side router, which swaps the preview underneath while the
// icon bar — marked `transition:persist` — stays in the DOM. Because the same
// element survives, CSS transitions animate the new selection growing and the
// old one shrinking, and a small script slides the bar so the selected icon
// stays in view.
//
// Layout follows Figma's "Home — Library" frame: a column whose left gutter
// (176px at lg+, see "Page grid" in global.css) holds the meta labels, with the
// icon bar, title, headline and values all starting at the column's left edge.
import { getCollection } from "astro:content";
import { Clock } from "pixelarticons/react/Clock";
import { Play } from "pixelarticons/react/Play";
import { projectIconMap } from "@/lib/projectIconMap";
import { slashList, typeIcon } from "@/lib/projectMeta";

interface Props {
  // Which project to preview. Omit for the first one (the /home page).
  slug?: string;
}

const projects = (
  await getCollection("projects", ({ data }) => data.published)
).sort((a, b) => a.data.order - b.data.order);

const current = projects.find((p) => p.id === Astro.props.slug) ?? projects[0];
const { data } = current;
const TypeIcon = data.type ? typeIcon(data.type) : null;

// Per-project colors are passed as inline custom properties; global.css
// resolves them to --icon-color / --badge-color for the active theme.
function colorVars(d: (typeof projects)[number]["data"]) {
  return {
    ...(d.iconColor ? { "--icon-color-light": d.iconColor } : {}),
    ...(d.iconColorDark ? { "--icon-color-dark": d.iconColorDark } : {}),
    ...(d.badgeColor ? { "--badge-color-light": d.badgeColor } : {}),
    ...(d.badgeColorDark ? { "--badge-color-dark": d.badgeColorDark } : {}),
  };
}

// "Project Ping" -> "Ping" for the small label under each icon.
const shortName = (name: string) => name.replace(/^Project\s+/, "");

// Split the headline around the accent phrase so it can be italicized and
// tinted in the project's own color.
const tagline = data.tagline;
const accentIndex = data.accentPhrase ? tagline.indexOf(data.accentPhrase) : -1;
const before = accentIndex >= 0 ? tagline.slice(0, accentIndex) : tagline;
const after =
  accentIndex >= 0
    ? tagline.slice(accentIndex + (data.accentPhrase?.length ?? 0))
    : "";
---

<main
  style="max-width: calc(var(--page-max) + 3rem);"
  class="mx-auto w-full px-6 pt-[70px] pb-8"
>
  <!-- Icon bar. Persisted across navigations (see the header comment). From lg
       up its left padding is the page gutter, which lines the first tile up with
       the text column below; on smaller screens it just scrolls sideways. -->
  <nav
    transition:persist="project-bar"
    aria-label="Projects"
    data-project-bar
    class="project-bar -mx-6 flex items-center gap-6 overflow-x-auto px-6 lg:pl-[calc(1.5rem+var(--page-gutter))]"
  >
    {
      projects.map((project, index) => {
        const Icon = projectIconMap[project.data.icon];
        return (
          <a
            href={`/home/${project.id}`}
            data-project-tile
            data-slug={project.id}
            data-first={index === 0 ? "" : undefined}
            aria-label={project.data.name}
            aria-current={project.id === current.id ? "page" : undefined}
            class="project-tile flex shrink-0 flex-col items-start gap-2"
            style={colorVars(project.data)}
          >
            <span class="tile-wrap">
              <span class="tile flex items-center justify-center">
                <Icon />
              </span>
            </span>
            <span class="tile-label">{shortName(project.data.name)}</span>
          </a>
        );
      })
    }
    <!-- Placeholder for future projects; not a link. -->
    <div
      class="project-tile project-tile--soon flex shrink-0 flex-col items-start gap-2"
    >
      <span class="tile-wrap">
        <span class="tile flex items-center justify-center">
          <Clock />
        </span>
      </span>
      <span class="tile-label">Coming soon</span>
    </div>
  </nav>

  <!-- The preview. Everything marked data-animate fades up in sequence each
       time a project is shown (see runFadeUpStagger in lib/animations.ts). -->
  <section
    style={colorVars(data)}
    class="mt-8 flex flex-col gap-8 lg:pl-[var(--page-gutter)]"
  >
    <div class="flex max-w-[888px] flex-col gap-6">
      <p data-animate class="preview-name">{data.name}</p>

      <h1 data-animate class="preview-headline">
        {before}
        {
          accentIndex >= 0 && (
            <span class="italic" style="color: var(--icon-color);">
              {data.accentPhrase}
            </span>
          )
        }
        {after}
      </h1>
    </div>

    <p data-animate class="preview-description">
      {data.summary ?? data.description}
    </p>
  </section>

  <!-- Details: a 640px block whose labels sit in the gutter (152px column) and
       whose values start at the content column (24px gap), per Figma. Each row
       is its own grid so the chip rows can center their label against the chip
       while the text rows (role, scope) align on the text baseline. -->
  <dl style={colorVars(data)} class="meta-grid mt-[84px]">
    {
      data.type && (
        <div class="meta-row">
          <dt data-animate class="meta-label">
            Type
          </dt>
          <dd data-animate class="m-0">
            <span class="meta-badge">
              {TypeIcon && <TypeIcon width={16} height={16} />}
              {data.type}
            </span>
          </dd>
        </div>
      )
    }
    {
      data.loomUrl && (
        <div class="meta-row">
          <dt data-animate class="meta-label">
            Accessories
          </dt>
          <dd data-animate class="m-0">
            <span class="meta-badge">
              <Play width={14} height={14} />
              Video walkthrough
            </span>
          </dd>
        </div>
      )
    }
    {
      data.role && (
        <div class="meta-row meta-row--text">
          <dt data-animate class="meta-label">
            Role
          </dt>
          <dd data-animate class="meta-value">
            {slashList(data.role)}
          </dd>
        </div>
      )
    }
    {
      data.scope && (
        <div class="meta-row meta-row--text">
          <dt data-animate class="meta-label">
            Scope
          </dt>
          <dd data-animate class="meta-value meta-value--wrap">
            {slashList(data.scope)}
          </dd>
        </div>
      )
    }
  </dl>
</main>

<style>
  .project-bar {
    /* Hide the scrollbar but keep the bar scrollable on narrow screens. */
    scrollbar-width: none;
  }
  .project-bar::-webkit-scrollbar {
    display: none;
  }

  /* ─── Cartridge tiles ──────────────────────────────────────────────────── */
  /* Figma's tiles aren't rounded squares: each corner is a little pixel
     staircase. --u is the size of one stair step; the clip-path below uses 3
     steps per corner. It's registered as a <length> so it can animate when a
     tile grows from small to selected. */
  @property --u {
    syntax: "<length>";
    inherits: true;
    initial-value: 1.5px;
  }

  .tile {
    --u: 1.5px;
    --tile-size: 72px;
    --icon-size: 32px;
    width: var(--tile-size);
    height: var(--tile-size);
    /* Unselected: the project color at 15% (same tint as the detail chips). */
    background-color: color-mix(in srgb, var(--icon-color) 15%, transparent);
    color: var(--icon-color);
    clip-path: polygon(
      calc(var(--u) * 3) 0,
      calc(100% - var(--u) * 3) 0,
      calc(100% - var(--u) * 3) var(--u),
      calc(100% - var(--u) * 2) var(--u),
      calc(100% - var(--u) * 2) calc(var(--u) * 2),
      calc(100% - var(--u)) calc(var(--u) * 2),
      calc(100% - var(--u)) calc(var(--u) * 3),
      100% calc(var(--u) * 3),
      100% calc(100% - var(--u) * 3),
      calc(100% - var(--u)) calc(100% - var(--u) * 3),
      calc(100% - var(--u)) calc(100% - var(--u) * 2),
      calc(100% - var(--u) * 2) calc(100% - var(--u) * 2),
      calc(100% - var(--u) * 2) calc(100% - var(--u)),
      calc(100% - var(--u) * 3) calc(100% - var(--u)),
      calc(100% - var(--u) * 3) 100%,
      calc(var(--u) * 3) 100%,
      calc(var(--u) * 3) calc(100% - var(--u)),
      calc(var(--u) * 2) calc(100% - var(--u)),
      calc(var(--u) * 2) calc(100% - var(--u) * 2),
      var(--u) calc(100% - var(--u) * 2),
      var(--u) calc(100% - var(--u) * 3),
      0 calc(100% - var(--u) * 3),
      0 calc(var(--u) * 3),
      var(--u) calc(var(--u) * 3),
      var(--u) calc(var(--u) * 2),
      calc(var(--u) * 2) calc(var(--u) * 2),
      calc(var(--u) * 2) var(--u),
      calc(var(--u) * 3) var(--u)
    );
  }
  .tile :global(svg) {
    width: var(--icon-size);
    height: var(--icon-size);
  }
  .project-tile--soon .tile {
    background-color: var(--portfolio-keycap);
    color: var(--portfolio-muted);
  }

  /* The selected tile: 128px, solid project color, cream icon at 56px, with a
     drop shadow on its wrapper (clip-path would cut off a box-shadow). */
  .project-tile[aria-current="page"] .tile {
    --u: 2.5px;
    --tile-size: 128px;
    --icon-size: 56px;
    background-color: var(--icon-color);
    color: #fff9f2;
  }
  .project-tile[aria-current="page"] .tile-wrap {
    filter: var(--cartridge-shadow);
  }

  /* Labels: 12px mono, 0.5px tracking, truncated to the 72px tile width. The
     selected tile keeps its (invisible) label so the column stays 152px tall,
     which is what vertically centers the smaller tiles beside it. */
  .tile-label {
    width: 72px;
    height: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.5px;
    color: var(--portfolio-muted);
  }
  .project-tile[aria-current="page"] .tile-label {
    visibility: hidden;
  }

  a.project-tile:not([aria-current="page"]):hover .tile {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile {
      transition:
        width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        --u 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        background-color 0.25s ease-out,
        color 0.25s ease-out,
        transform 0.2s ease-out;
    }
    .tile :global(svg) {
      transition:
        width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  a.project-tile:focus {
    outline: none;
  }
  a.project-tile:focus-visible .tile-wrap {
    outline: 2px solid var(--icon-color, currentColor);
    outline-offset: 3px;
  }

  /* ─── Preview text ─────────────────────────────────────────────────────── */
  .preview-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 20px;
    line-height: 1.4;
    letter-spacing: -0.2px;
    color: var(--portfolio-ink);
  }
  /* Redaction 35 at 64px on desktop (scaling down on smaller screens), 0.94
     line height, -1.92px tracking. No text-wrap balancing: Figma lets the line
     fill the column, so "Rethinking how users know" stays on one line. */
  .preview-headline {
    margin: 0;
    font-family: var(--font-redaction);
    font-size: clamp(2.75rem, 1.2rem + 4.2vw, 4rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.03em;
    color: var(--portfolio-ink);
  }
  .preview-description {
    margin: 0;
    max-width: 620px;
    font-family: var(--font-plex-sans);
    font-size: 18px;
    line-height: 28px;
    color: color-mix(in srgb, var(--portfolio-ink) 85%, transparent);
  }

  /* ─── Details ──────────────────────────────────────────────────────────── */
  /* Rows 17px apart; within a row, labels take a 152px column and values start
     after a 24px gap. Stacked (label above value) below lg, where there's no
     gutter. */
  .meta-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 640px;
  }
  .meta-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 24px;
    align-items: center;
  }
  .meta-row--text {
    align-items: baseline;
  }
  @media (min-width: 64rem) {
    .meta-grid {
      gap: 17px;
    }
    .meta-row {
      grid-template-columns: 152px minmax(0, 1fr);
    }
  }

  /* Figma sets all of these in IBM Plex Mono at its "normal" line height (about
     1.3), not the 1.5 the base styles would otherwise give them. */
  .meta-label {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: normal;
    text-transform: uppercase;
    color: var(--portfolio-muted);
  }
  .meta-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: normal;
    text-transform: uppercase;
    color: var(--portfolio-ink);
  }
  /* Scope is a longer run of text: 24px line height, wrapping in the value column. */
  .meta-value--wrap {
    line-height: 24px;
  }
  /* The chips: 15% project-color fill, 8px/3px padding, 4px corners. */
  .meta-badge {
    /* Block-level (not inline-flex) so the surrounding <dd> doesn't add a line
       box around it, which would make each chip row taller than the chip. */
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 4px;
    background-color: color-mix(in srgb, var(--icon-color) 15%, transparent);
    color: var(--portfolio-ink);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    line-height: normal;
  }
  .meta-badge :global(svg) {
    color: var(--icon-color);
  }
</style>

<script>
  // Keeps the persisted icon bar in sync with the page: marks the tile for the
  // current URL as selected and slides the bar so it's in view. Runs on first
  // load and after every client-side navigation.
  document.addEventListener("astro:page-load", () => {
    const bar = document.querySelector<HTMLElement>("[data-project-bar]");
    if (!bar) return;

    const tiles = [...bar.querySelectorAll<HTMLElement>("[data-project-tile]")];
    // /home and /home/<slug>. /home alone means "the first project".
    const slug = location.pathname.match(/^\/home\/([^/]+)/)?.[1];
    const active = tiles.find((t) =>
      slug ? t.dataset.slug === slug : t.hasAttribute("data-first"),
    );
    if (!active) return;

    const alreadyActive = active.getAttribute("aria-current") === "page";
    tiles.forEach((t) => {
      if (t === active) t.setAttribute("aria-current", "page");
      else t.removeAttribute("aria-current");
    });

    // Slide the bar (not the page) so the selected tile sits in the middle.
    // 128 is the selected tile's final width (see the CSS above), so the
    // math doesn't depend on where the width transition currently is.
    const left = active.offsetLeft - (bar.clientWidth - 128) / 2;
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    bar.scrollTo({
      left: Math.max(0, left),
      behavior: reduce || alreadyActive ? "auto" : "smooth",
    });
  });
</script>
